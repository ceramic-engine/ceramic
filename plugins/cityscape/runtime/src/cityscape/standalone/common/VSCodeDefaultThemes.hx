    /** Dark+ as a VS Code theme object (`{name, type, colors, settings}`). */
    public static function darkPlus():Dynamic {
        return haxe.Json.parse(DARK_PLUS_JSON);
    }

    /** Light+ as a VS Code theme object (`{name, type, colors, settings}`). */
    public static function lightPlus():Dynamic {
        return haxe.Json.parse(LIGHT_PLUS_JSON);
    }

    /**
     * Defines `dark-plus` and `light-plus` in `context` (once) and sets
     * the dark or the light one.
     */
    public static function apply(context:Cityscape, dark:Bool):Void {
        final service = context.themeService;
        if (!defined.exists(context)) {
            defined.set(context, true);
            service.defineTheme(DARK_PLUS, VSCodeTheme.toStandaloneThemeData(darkPlus()));
            service.defineTheme(LIGHT_PLUS, VSCodeTheme.toStandaloneThemeData(lightPlus()));
        }
        final name = dark ? DARK_PLUS : LIGHT_PLUS;
        if (current.get(context) != name) {
            current.set(context, name);
            service.setTheme(name);
        }
    }

    static final defined:haxe.ds.ObjectMap<Cityscape, Bool> = new haxe.ds.ObjectMap();

    static final current:haxe.ds.ObjectMap<Cityscape, String> = new haxe.ds.ObjectMap();

