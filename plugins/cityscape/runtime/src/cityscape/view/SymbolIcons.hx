    static var cache:Null<Map<String, haxe.io.Bytes>> = null;

    /**
     * The SVG bytes of the Lucide icon standing for a codicon id
     * (`symbol-method`, `lightbulb`, `error`...).
     */
    public static function codiconSvg(codicon:String):haxe.io.Bytes {
        if (cache == null) {
            cache = new Map();
        }
        var bytes = cache.get(codicon);
        if (bytes == null) {
            bytes = haxe.io.Bytes.ofString(svgOf(codicon));
            cache.set(codicon, bytes);
        }
        return bytes;
    }

    static function svgOf(codicon:String):String {
        return switch codicon {
            case 'symbol-method' | 'symbol-constructor': box;
            case 'symbol-function': squareFunction;
            case 'symbol-field': tag;
            case 'symbol-variable': variable;
            case 'symbol-class': component;
            case 'symbol-struct' | 'symbol-object': shapes;
            case 'symbol-interface': brackets;
            case 'symbol-module' | 'symbol-namespace' | 'symbol-package': braces;
            case 'symbol-property': wrench;
            case 'symbol-event': zap;
            case 'symbol-operator': plus;
            case 'symbol-unit': ruler;
            case 'symbol-value' | 'symbol-constant' | 'symbol-number': hash;
            case 'symbol-enum' | 'symbol-array': list;
            case 'symbol-enum-member': listTree;
            case 'symbol-keyword' | 'symbol-key': keyRound;
            case 'symbol-text' | 'symbol-string': text;
            case 'symbol-color' | 'symbol-customcolor': palette;
            case 'symbol-file': file;
            case 'symbol-reference': link;
            case 'symbol-folder': folder;
            case 'symbol-type-parameter': type;
            case 'account': user;
            case 'issues': circleAlert;
            case 'symbol-snippet': scissors;
            case 'lightbulb' | 'lightbulb-autofix': lightbulb;
            case 'lightbulb-sparkle': sparkles;
            case 'error': circleX;
            case 'warning': triangleAlert;
            case 'info': info;
            case _: wrench;
        };
    }

}
