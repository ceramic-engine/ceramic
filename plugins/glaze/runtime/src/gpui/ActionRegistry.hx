package gpui;

/**
 * Builds actions by name, typically from keymap entries. One per `App`
 * (`app.actions`), loaded from every action registered by `ActionMacro`.
 */
class ActionRegistry {

    /**
     * Every action registered by `ActionMacro` (Rust: `inventory`). Filled from
     * the `__init__` of each action class, so it has no initializer.
     */
    static var macroActions:Array<MacroActionData>;

    /**
     * Called by the code generated by `ActionMacro`.
     */
    @:noCompletion public static function registerMacroAction(data:MacroActionData):Void {
        if (macroActions == null) {
            macroActions = [];
        }
        macroActions.push(data);
    }

    /**
     * Generate a list of all the registered actions. Useful for transforming the
     * list of available actions into a format suited for static analysis such as
     * in validating keymaps, or generating documentation.
     */
    public static function generateListOfAllRegisteredActions():Array<MacroActionData> {
        return macroActions != null ? macroActions.copy() : [];
    }

    final byName:Map<String, MacroActionData> = new Map();

    final namesByTypeName:Map<String, String> = new Map();

    final allNames:Array<String> = [];

    final deprecatedAliasesByName:Map<String, String> = new Map();

    final deprecationMessagesByName:Map<String, String> = new Map();

    final documentationByName:Map<String, String> = new Map();

    public function new() {
        loadActions();
    }

    /**
     * Load all registered actions into the registry.
     */
    @:allow(gpui)
    function loadActions():Void {
        if (macroActions == null) return;
        for (action in macroActions) {
            insertAction(action);
        }
    }

    /**
     * Inserts one action. Throws if the name (or an alias) is already registered.
     */
    public function insertAction(action:MacroActionData):Void {
        final name = action.name;
        if (byName.exists(name)) {
            throw new haxe.Exception(
                'Action with name `$name` already registered '
                + '(might be registered in `@:action(deprecatedAliases = [...])`.'
            );
        }
        byName.set(name, action);
        for (alias in action.deprecatedAliases) {
            if (byName.exists(alias)) {
                throw new haxe.Exception(
                    'Action with name `$alias` already registered. '
                    + '`$alias` is specified in `@:action(deprecatedAliases = [...])` for action `$name`.'
                );
            }
            byName.set(alias, action);
            deprecatedAliasesByName.set(alias, name);
            allNames.push(alias);
        }
        namesByTypeName.set(action.typeName, name);
        allNames.push(name);
        if (action.deprecationMessage != null) {
            deprecationMessagesByName.set(name, action.deprecationMessage);
        }
        if (action.documentation != null) {
            documentationByName.set(name, action.documentation);
        }
    }

    /**
     * Construct an action of the given class with no parameters (Rust:
     * `build_action_type`, keyed by `TypeId`).
     */
    public function buildActionType(type:Class<Action>):Action {
        final typeName = Type.getClassName(type);
        final name = namesByTypeName.get(typeName);
        if (name == null) {
            throw new haxe.Exception('no action type registered for $typeName');
        }
        return buildAction(name, null);
    }

    /**
     * Construct an action based on its name and optional JSON parameters
     * sourced from the keymap (a value parsed by `haxe.Json.parse`; `{}` when
     * null). Throws `ActionBuildError`.
     */
    public function buildAction(name:String, ?params:Dynamic):Action {
        final data = byName.get(name);
        if (data == null) {
            throw ActionBuildError.notFound(name);
        }
        try {
            return data.build(params != null ? params : {});
        }
        catch (e:haxe.Exception) {
            throw ActionBuildError.buildError(name, e);
        }
    }

    public function allActionNames():Array<String> {
        return allNames;
    }

    /**
     * Deprecated name to preferred name.
     */
    public function deprecatedAliases():Map<String, String> {
        return deprecatedAliasesByName;
    }

    /**
     * Action name to deprecation message.
     */
    public function deprecationMessages():Map<String, String> {
        return deprecationMessagesByName;
    }

    /**
     * Action name to documentation.
     */
    public function documentation():Map<String, String> {
        return documentationByName;
    }

}
