package gpui.component;

import gpui.App;
import gpui.AppContext;
import gpui.IntoElement;
import gpui.RenderOnce;
import gpui.Window;

/**
 * Default component icon names: the 106 icons of gpui-kit's
 * `default-icons.txt` (Lucide icons, ISC, some derived from Feather, MIT,
 * plus a few gpui-kit icons), bundled with the plugin in `assets/icons`
 * (see `assets/icons/LICENSE-LUCIDE.txt`).
 *
 * The variants are generated by `IconNameMacro` from the files of
 * `assets/icons`: `IconName.ChevronDown` is `"icons/chevron-down.svg"`, the
 * path understood by the asset source. To embed more icons, either copy SVG
 * files into the plugin's `assets/icons` (they get a variant here), or copy
 * them into your project's assets and draw them by path:
 * `Icon.empty().path("icons/alarm-clock.svg")` (the complete Lucide catalog
 * of gpui-kit is in `gpui-kit/crates/assets/assets/icons`).
 *
 * On targets without synchronous file access (the web), call
 * `IconName.preload(done)` before rendering icons.
 */
@:build(gpui.component.IconNameMacro.build())
enum abstract IconName(String) to String {

    /**
     * The path understood by the bundled asset source.
     */
    public inline function path():String {
        return this;
    }

    /**
     * Rust `IconName::view`: the icon as an `Entity<Icon>`.
     */
    public function view(cx:AppContext):gpui.Entity<Icon.IconView> {
        return Icon.build(this).view(cx);
    }

    /**
     * Rust `impl From<IconName> for AnyElement` / `RenderOnce for IconName`.
     */
    @:to public inline function toIntoElement():IntoElement {
        return (Icon.build(this) : RenderOnce);
    }

    /**
     * Preloads every bundled icon into the default asset source (needed on
     * the web before rendering icons), then calls `done(success)`.
     */
    public static function preload(done:Bool->Void):Void {
        App.defaultAssetSource().preload([for (name in ALL) name.path()], done);
    }

}
