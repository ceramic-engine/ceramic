package gpui;

/**
 * A `TextStyle` where every field is optional: applied on top of a text
 * style with `TextStyle.refine()`.
 *
 * Object fields are unset when `null`. Fields of value types (font weight,
 * font style, white space, text align, line clamp) are unset unless their bit
 * is set in `mask` (see `has()`), which avoids boxed `Null<T>` values.
 */
class TextStyleRefinement {

    public static inline final FONT_WEIGHT:Int = 1 << 0;
    public static inline final FONT_STYLE:Int = 1 << 1;
    public static inline final WHITE_SPACE:Int = 1 << 2;
    public static inline final TEXT_ALIGN:Int = 1 << 3;
    public static inline final LINE_CLAMP:Int = 1 << 4;

    /** Bits of the value type fields that are set */
    public var mask:Int = 0;

    /**
     * The text style last composed from this refinement by a window
     * (`Window.currentTextStyle`): `composedStyle` is `composedParent`
     * refined with this refinement, valid during frame `composedFrame` of
     * `composedWindow` only (the refinement and its parent are not changed
     * while a frame is drawn). Internal.
     */
    @:noCompletion public var composedWindow:Null<Window> = null;
    @:noCompletion public var composedFrame:Int = -1;
    @:noCompletion public var composedParent:Null<TextStyle> = null;
    @:noCompletion public var composedStyle:Null<TextStyle> = null;

    public var color:Null<Hsla> = null;
    public var fontFamily:Null<String> = null;
    public var fontFeatures:Null<FontFeatures> = null;
    public var fontFallbacks:Null<FontFallbacks> = null;
    public var fontSize:Null<AbsoluteLength> = null;
    public var lineHeight:Null<DefiniteLength> = null;
    public var backgroundColor:Null<Hsla> = null;
    public var underline:Null<UnderlineStyle> = null;
    public var strikethrough:Null<StrikethroughStyle> = null;
    public var textOverflow:Null<TextOverflow> = null;

    public var fontWeight(default, set):FontWeight = FontWeight.NORMAL;
    inline function set_fontWeight(value:FontWeight):FontWeight {
        mask |= FONT_WEIGHT;
        return fontWeight = value;
    }

    public var fontStyle(default, set):FontStyle = Normal;
    inline function set_fontStyle(value:FontStyle):FontStyle {
        mask |= FONT_STYLE;
        return fontStyle = value;
    }

    public var whiteSpace(default, set):WhiteSpace = Normal;
    inline function set_whiteSpace(value:WhiteSpace):WhiteSpace {
        mask |= WHITE_SPACE;
        return whiteSpace = value;
    }

    public var textAlign(default, set):TextAlign = Left;
    inline function set_textAlign(value:TextAlign):TextAlign {
        mask |= TEXT_ALIGN;
        return textAlign = value;
    }

    public var lineClamp(default, set):Int = -1;
    inline function set_lineClamp(value:Int):Int {
        mask |= LINE_CLAMP;
        return lineClamp = value;
    }

    public function new() {}

    /**
     * `true` if the value type field of the given bit is set.
     */
    public inline function has(bit:Int):Bool {
        return (mask & bit) != 0;
    }

    /**
     * Unsets the value type field of the given bit.
     */
    public inline function unset(bit:Int):Void {
        mask &= ~bit;
    }

    /**
     * `true` if at least one field is set (Rust `is_some()`).
     */
    public function isSome():Bool {
        return mask != 0 || color != null || fontFamily != null || fontFeatures != null || fontFallbacks != null || fontSize != null || lineHeight != null
            || backgroundColor != null || underline != null || strikethrough != null || textOverflow != null;
    }

    /**
     * Applies the fields set in the given refinement on top of this one.
     */
    public function refine(refinement:TextStyleRefinement):Void {
        if (refinement == null)
            return;
        // Changed: what it composed no longer holds
        composedStyle = null;
        composedFrame = -1;
        if (refinement.color != null) color = refinement.color;
        if (refinement.fontFamily != null) fontFamily = refinement.fontFamily;
        if (refinement.fontFeatures != null) fontFeatures = refinement.fontFeatures;
        if (refinement.fontFallbacks != null) fontFallbacks = refinement.fontFallbacks;
        if (refinement.fontSize != null) fontSize = refinement.fontSize;
        if (refinement.lineHeight != null) lineHeight = refinement.lineHeight;
        if (refinement.has(FONT_WEIGHT)) fontWeight = refinement.fontWeight;
        if (refinement.has(FONT_STYLE)) fontStyle = refinement.fontStyle;
        if (refinement.backgroundColor != null) backgroundColor = refinement.backgroundColor;
        if (refinement.underline != null) underline = refinement.underline;
        if (refinement.strikethrough != null) strikethrough = refinement.strikethrough;
        if (refinement.has(WHITE_SPACE)) whiteSpace = refinement.whiteSpace;
        if (refinement.textOverflow != null) textOverflow = refinement.textOverflow;
        if (refinement.has(TEXT_ALIGN)) textAlign = refinement.textAlign;
        if (refinement.has(LINE_CLAMP)) lineClamp = refinement.lineClamp;
    }

    public function clone():TextStyleRefinement {
        final result = new TextStyleRefinement();
        result.refine(this);
        return result;
    }

    /**
     * Structural equality (Rust `#[derive(PartialEq)]` on the refinement).
     * Value type fields compare only when set, like `Option` fields.
     */
    public function equals(other:Null<TextStyleRefinement>):Bool {
        if (other == null)
            return !isSome();
        if (mask != other.mask)
            return false;
        if (has(FONT_WEIGHT) && fontWeight != other.fontWeight) return false;
        if (has(FONT_STYLE) && fontStyle != other.fontStyle) return false;
        if (has(WHITE_SPACE) && whiteSpace != other.whiteSpace) return false;
        if (has(TEXT_ALIGN) && textAlign != other.textAlign) return false;
        if (has(LINE_CLAMP) && lineClamp != other.lineClamp) return false;
        return RefinementEq.hsla(color, other.color) && fontFamily == other.fontFamily
            && (fontFeatures == null ? other.fontFeatures == null : other.fontFeatures != null && fontFeatures.equals(other.fontFeatures))
            && (fontFallbacks == null ? other.fontFallbacks == null : other.fontFallbacks != null && fontFallbacks.equals(other.fontFallbacks))
            && RefinementEq.absolute(fontSize, other.fontSize) && RefinementEq.definite(lineHeight, other.lineHeight)
            && RefinementEq.hsla(backgroundColor, other.backgroundColor)
            && (underline == null ? other.underline == null : other.underline != null && underline.equals(other.underline))
            && (strikethrough == null ? other.strikethrough == null : other.strikethrough != null && strikethrough.equals(other.strikethrough))
            && (textOverflow == null ? other.textOverflow == null : other.textOverflow != null && Type.enumEq(textOverflow, other.textOverflow));
    }

}
