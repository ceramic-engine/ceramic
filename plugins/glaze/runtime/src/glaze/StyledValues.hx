package glaze;

/**
 * Shared values used by the `Styled` methods. The length constants
 * (`LENGTH_BOX_2`, `DEFINITE_BOX_NEG_0P5`, `ABSOLUTE_CORNER_MD`,
 * `ABSOLUTE_BORDER_4`...) are generated by `StyledMacro.buildValues()` from
 * the scales of `gpui_macros`. Enum values are immutable, so sharing them
 * avoids allocating when styling elements.
 */
@:build(glaze.StyledMacro.buildValues())
class StyledValues {

    /** The ellipsis used by `textEllipsis()` and `truncate()` */
    public static final ELLIPSIS:String = '…';

    /** `relative(0.0)`, the flex basis of `flex1()` */
    public static final LENGTH_RELATIVE_ZERO:Length = Length.Definite(DefiniteLength.Fraction(0.0));

    public static final TEXT_XS:AbsoluteLength = AbsoluteLength.Rems(0.75);
    public static final TEXT_SM:AbsoluteLength = AbsoluteLength.Rems(0.875);
    public static final TEXT_BASE:AbsoluteLength = AbsoluteLength.Rems(1.0);
    public static final TEXT_LG:AbsoluteLength = AbsoluteLength.Rems(1.125);
    public static final TEXT_XL:AbsoluteLength = AbsoluteLength.Rems(1.25);
    public static final TEXT_2XL:AbsoluteLength = AbsoluteLength.Rems(1.5);
    public static final TEXT_3XL:AbsoluteLength = AbsoluteLength.Rems(1.875);

    static final SHADOW_PRESETS:Map<String, Array<BoxShadow>> = [
        '2xs' => [new BoxShadow(0.0, 1.0, new Hsla(0.0, 0.0, 0.0, 0.05))],
        'xs' => [new BoxShadow(0.0, 1.0, new Hsla(0.0, 0.0, 0.0, 0.05)).withBlurRadius(2.0)],
        'sm' => [
            new BoxShadow(0.0, 1.0, new Hsla(0.0, 0.0, 0.0, 0.1)).withBlurRadius(3.0),
            new BoxShadow(0.0, 1.0, new Hsla(0.0, 0.0, 0.0, 0.1)).withBlurRadius(2.0).withSpreadRadius(-1.0)
        ],
        'md' => [
            new BoxShadow(0.0, 4.0, new Hsla(0.0, 0.0, 0.0, 0.1)).withBlurRadius(6.0).withSpreadRadius(-1.0),
            new BoxShadow(0.0, 2.0, new Hsla(0.0, 0.0, 0.0, 0.1)).withBlurRadius(4.0).withSpreadRadius(-2.0)
        ],
        'lg' => [
            new BoxShadow(0.0, 10.0, new Hsla(0.0, 0.0, 0.0, 0.1)).withBlurRadius(15.0).withSpreadRadius(-3.0),
            new BoxShadow(0.0, 4.0, new Hsla(0.0, 0.0, 0.0, 0.1)).withBlurRadius(6.0).withSpreadRadius(-4.0)
        ],
        'xl' => [
            new BoxShadow(0.0, 20.0, new Hsla(0.0, 0.0, 0.0, 0.1)).withBlurRadius(25.0).withSpreadRadius(-5.0),
            new BoxShadow(0.0, 8.0, new Hsla(0.0, 0.0, 0.0, 0.1)).withBlurRadius(10.0).withSpreadRadius(-6.0)
        ],
        '2xl' => [new BoxShadow(0.0, 25.0, new Hsla(0.0, 0.0, 0.0, 0.25)).withBlurRadius(50.0).withSpreadRadius(-12.0)]
    ];

    /**
     * The shadows of a Tailwind preset (`2xs`, `xs`, `sm`, `md`, `lg`, `xl`,
     * `2xl`), shared between elements: they must not be mutated.
     */
    public static function shadowPreset(name:String):Array<BoxShadow> {
        return SHADOW_PRESETS.get(name);
    }

    /**
     * The underline of the text style of the given refinement, created with
     * default values if needed (Rust `underline.get_or_insert_with(Default::default)`).
     */
    public static function underlineOf(style:StyleRefinement):UnderlineStyle {
        final text = style.textStyle();
        if (text.underline == null) {
            text.underline = new UnderlineStyle();
        }
        return text.underline;
    }

}
