package glaze;

#if macro
import haxe.macro.Context;
import haxe.macro.Expr;
import haxe.macro.Type;
#end

/**
 * Builds the reflection table of a style trait (Rust
 * `#[derive_inspector_reflection]`: the trait methods of the form
 * `fn name(self) -> Self`, in declaration order with the style macros
 * expanded first, with their documentation).
 *
 * The Rust macro walks the trait's source. The port's `Styled` methods are
 * generated by `StyledMacro` in another order, so the table (names in
 * order and documentation) is data extracted from the original by
 * `reference/examples/inspector_reflection.rs`, a JSON file next to the
 * class being built. Each name is mapped to the port's camelCase method,
 * and a name the port does not have is a compile error.
 *
 * The built class gets `methods()` and `findMethod(name)`, like the
 * module `<trait>_reflection` of the Rust macro, specialized to
 * `StyleRefinement` (the only type the inspector reflects).
 */
class StyledReflectionMacro {

    #if macro
    /**
     * `file`: the JSON table, relative to the class being built.
     * `ext`: true for gpui-base's `StyledExt` (static extension methods of
     * `glaze.kit.base.StyledExt`), false for `Styled` (methods of `StyleBuilder`).
     */
    public static function build(file:String, ext:Bool):Array<Field> {
        final fields = Context.getBuildFields();
        final pos = Context.currentPos();
        final classFile = Context.getPosInfos(pos).file;
        final path = haxe.io.Path.join([haxe.io.Path.directory(sys.FileSystem.fullPath(classFile)), file]);
        Context.registerModuleDependency(Context.getLocalModule(), path);
        final data:{methods:Array<Array<Dynamic>>, docs:Array<String>} = haxe.Json.parse(sys.io.File.getContent(path));

        final available = new Map<String, Bool>();
        if (!ext) {
            // Methods of the builder itself, and the generated methods of
            // every `Styled` (static extensions of `StyledMethods`)
            switch Context.getType('glaze.StyleBuilder') {
                case TInst(ref, _):
                    for (field in ref.get().fields.get()) {
                        available.set(field.name, true);
                    }
                case _:
            }
            switch Context.getType('glaze.StyledMethods') {
                case TInst(ref, _):
                    for (field in ref.get().statics.get()) {
                        available.set(field.name, true);
                    }
                case _:
            }
        }
        else {
            switch Context.getType('glaze.kit.base.StyledExt') {
                case TInst(ref, _):
                    for (field in ref.get().statics.get()) {
                        available.set(field.name, true);
                    }
                case _:
            }
        }

        final names:Array<Expr> = [];
        final docIndices:Array<Expr> = [];
        final cases:Array<Case> = [];
        final missing:Array<String> = [];
        for (i in 0...data.methods.length) {
            final rustName:String = data.methods[i][0];
            final docIndex:Int = data.methods[i][1];
            final method = StyledMacro.camelCase(rustName);
            if (!available.exists(method)) {
                missing.push(rustName + ' (' + method + ')');
                continue;
            }
            names.push(macro $v{rustName});
            docIndices.push(macro $v{docIndex});
            final index = names.length - 1;
            final call = ext
                ? macro glaze.kit.base.StyledExt.$method(builder)
                : macro builder.$method();
            cases.push({values: [macro $v{index}], expr: macro $call});
        }
        if (missing.length > 0) {
            Context.error('Style methods of the reflection table missing from the port: ' + missing.join(', '), pos);
        }

        final docs:Array<Expr> = [for (doc in data.docs) macro $v{doc}];
        final switchExpr:Expr = {
            expr: ESwitch(macro index, cases, macro {}),
            pos: pos
        };

        final added = macro class {
            static final NAMES:Array<String> = $a{names};

            static final DOC_INDICES:Array<Int> = $a{docIndices};

            static final DOCS:Array<String> = $a{docs};

            static function dispatch(index:Int, style:glaze.StyleRefinement):glaze.StyleRefinement {
                final builder = new glaze.StyleBuilder(style);
                $switchExpr;
                return style;
            }

            /**
             * Get all reflectable methods for a style refinement.
             */
            public static function methods():Array<glaze.FunctionReflection<glaze.StyleRefinement>> {
                return [for (i in 0...NAMES.length) new glaze.FunctionReflection<glaze.StyleRefinement>(NAMES[i], DOC_INDICES[i] >= 0 ? DOCS[DOC_INDICES[i]] : null, i, dispatch)];
            }

            /**
             * Find a method by name.
             */
            public static function findMethod(name:String):Null<glaze.FunctionReflection<glaze.StyleRefinement>> {
                for (method in methods()) {
                    if (method.name == name) return method;
                }
                return null;
            }
        };
        for (field in added.fields) fields.push(field);
        return fields;
    }
    #end

}
