package gpui;

/**
 * A keystroke and associated metadata generated by the platform.
 *
 * Fields are mutable like the Rust struct; methods that consume `self` in Rust
 * (`withSimulatedIme`) return a modified copy. Compare with `equals()`.
 *
 * Rust's `AsKeystroke` helper trait is not needed: functions taking typed
 * input take `Array<Keystroke>`, and `KeybindingKeystroke.inner()` converts.
 */
class Keystroke {

    /**
     * The state of the modifier keys at the time the keystroke was generated.
     */
    public var modifiers:Modifiers;

    /**
     * The character printed on the key that was pressed, e.g. for option-s, key
     * is "s". On layouts that do not have ascii keys (e.g. Thai) this is the
     * ASCII-equivalent character (q instead of the Thai character), and the
     * typed character is in `keyChar`.
     */
    public var key:String;

    /**
     * The character that could have been typed when this binding was pressed,
     * e.g. for s this is "s", for option-s "ß", and for cmd-s null.
     */
    public var keyChar:Null<String>;

    public function new(modifiers:Modifiers, key:String, ?keyChar:String) {
        this.modifiers = modifiers;
        this.key = key;
        this.keyChar = keyChar;
    }

    public function copy():Keystroke {
        return new Keystroke(modifiers, key, keyChar);
    }

    public function equals(other:Keystroke):Bool {
        return other != null && modifiers == other.modifiers && key == other.key && keyChar == other.keyChar;
    }

    /**
     * When matching a key we cannot know whether the user intended to type the
     * keyChar or the key itself. On some non-US keyboards keys we use in our
     * bindings are behind option (for example `$` is typed `alt-ç` on a Czech
     * keyboard), and on some keyboards the IME handler converts a sequence of
     * keys into a specific character (for example `"` is typed as `" space` on a
     * brazilian keyboard).
     *
     * This method assumes that `this` was typed and `target` is in the keymap,
     * and checks both possibilities for `this` against the target.
     *
     * GPUI picks the Windows variant at compile time; here it follows
     * `OperatingSystem.current`.
     */
    public function shouldMatch(target:KeybindingKeystroke):Bool {
        final keyChar = this.keyChar;
        if (keyChar != null && keyChar != key) {
            final targetInner = target.inner();
            if (OperatingSystem.current != Windows) {
                final imeModifiers = Modifiers.of(modifiers.control, false, false, modifiers.platform, false);
                if (targetInner.key == keyChar && targetInner.modifiers == imeModifiers) {
                    return true;
                }
            }
            else {
                // On Windows, if keyChar is set, then the typed keystroke produced the keyChar
                if (targetInner.key == keyChar && targetInner.modifiers == Modifiers.none()) {
                    return true;
                }
            }
        }

        final targetInner = target.inner();
        return targetInner.modifiers == modifiers && targetInner.key == key;
    }

    /**
     * Parses a static keystroke with explicit, platform-independent modifiers.
     *
     * Syntax: `[ctrl-][alt-][shift-][cmd-][fn-]key[->key_char]`.
     * The `key_char` suffix is used for generating test events.
     * Use `parseWithOs` for dynamic input or the `secondary-` alias.
     *
     * Throws `InvalidKeystrokeError`.
     */
    public static function parse(source:String):Keystroke {
        return parseInternal(source, null);
    }

    /**
     * Like `parse`, but returns null instead of throwing.
     */
    public static function tryParse(source:String, ?os:OperatingSystem):Null<Keystroke> {
        try {
            return parseInternal(source, os);
        }
        catch (e:InvalidKeystrokeError) {
            return null;
        }
    }

    /**
     * Parses a keystroke, resolving `secondary-` using the supplied host OS.
     */
    public static function parseWithOs(source:String, os:OperatingSystem):Keystroke {
        return parseInternal(source, os);
    }

    static function parseInternal(source:String, os:Null<OperatingSystem>):Keystroke {
        var modifiers = Modifiers.none();
        var key:Null<String> = null;
        var keyChar:Null<String> = null;

        final components = source.split('-');
        var i = 0;
        while (i < components.length) {
            final component = components[i++];
            final lower = asciiLowerCase(component);
            if (lower == 'ctrl') {
                modifiers = modifiers.withControl(true);
                continue;
            }
            if (lower == 'alt') {
                modifiers = modifiers.withAlt(true);
                continue;
            }
            if (lower == 'shift') {
                modifiers = modifiers.withShift(true);
                continue;
            }
            if (lower == 'fn') {
                modifiers = modifiers.withFunction(true);
                continue;
            }
            if (lower == 'secondary') {
                if (os == null) {
                    throw new InvalidKeystrokeError(source);
                }
                if (os == Mac) {
                    modifiers = modifiers.withPlatform(true);
                }
                else {
                    modifiers = modifiers.withControl(true);
                }
                continue;
            }

            final isPlatform = lower == 'cmd' || lower == 'super' || lower == 'win';

            if (isPlatform) {
                modifiers = modifiers.withPlatform(true);
                continue;
            }

            var keyStr = component;

            if (i < components.length) {
                final next = components[i];
                if (next.length == 0 && StringTools.endsWith(source, '-')) {
                    key = '-';
                    break;
                }
                else if (next.length > 1 && StringTools.startsWith(next, '>')) {
                    key = keyStr;
                    keyChar = next.substr(1);
                    i++;
                }
                else {
                    throw new InvalidKeystrokeError(source);
                }
                continue;
            }

            if (component.length == 1 && isAsciiUppercase(StringTools.fastCodeAt(component, 0))) {
                // Convert to shift + lowercase char
                modifiers = modifiers.withShift(true);
                keyStr = asciiLowerCase(keyStr);
            }
            else {
                // Convert ascii chars to lowercase so that named keys like "tab" and "enter"
                // are accepted case insensitively and stored how we expect so they are matched properly
                keyStr = asciiLowerCase(keyStr);
            }
            key = keyStr;
        }

        // Allow for the user to specify a keystroke modifier as the key itself.
        // This sets the `key` to the modifier, and disables the modifier
        if (key == null) {
            if (modifiers.shift) {
                modifiers = modifiers.withShift(false);
                key = 'shift';
            }
            else if (modifiers.control) {
                modifiers = modifiers.withControl(false);
                key = 'control';
            }
            else if (modifiers.alt) {
                modifiers = modifiers.withAlt(false);
                key = 'alt';
            }
            else if (modifiers.platform) {
                modifiers = modifiers.withPlatform(false);
                key = 'platform';
            }
            else if (modifiers.function_) {
                modifiers = modifiers.withFunction(false);
                key = 'function';
            }
        }

        if (key == null) {
            throw new InvalidKeystrokeError(source);
        }

        return new Keystroke(modifiers, key, keyChar);
    }

    /**
     * Serializes this keystroke with the supplied host OS's modifier spelling.
     */
    public function unparse(os:OperatingSystem):String {
        return unparseKeystroke(modifiers, key, os);
    }

    /**
     * Formats this keystroke using the supplied host OS's key labels
     * (Rust returns a `KeystrokeDisplay` implementing `Display`).
     */
    public function display(os:OperatingSystem):String {
        return displayKeystroke(modifiers, key, os);
    }

    /**
     * Returns true if this keystroke left the ime system in an incomplete state.
     */
    public function isImeInProgress():Bool {
        return keyChar == null
            && (isPrintableKey(key) || key.length == 0)
            && !(modifiers.platform || modifiers.control || modifiers.function_ || modifiers.alt);
    }

    /**
     * Returns a new keystroke with the keyChar filled. This is used for
     * dispatchKeystroke where we want users to be able to simulate typing
     * "space", etc.
     */
    public function withSimulatedIme():Keystroke {
        final result = copy();
        if (keyChar == null && !modifiers.platform && !modifiers.control && !modifiers.function_ && !modifiers.alt) {
            result.keyChar = switch key {
                case 'space': ' ';
                case 'tab': '\t';
                case 'enter': '\n';
                case k if (!isPrintableKey(k) || k.length == 0): null;
                case k: modifiers.shift ? k.toUpperCase() : k;
            }
        }
        return result;
    }

    public function toString():String {
        return 'Keystroke(' + unparse(Mac) + (keyChar != null ? ' -> ' + keyChar : '') + ')';
    }

/// Helpers (shared with KeybindingKeystroke)

    @:allow(gpui)
    static function isPrintableKey(key:String):Bool {
        return switch key {
            case 'f1' | 'f2' | 'f3' | 'f4' | 'f5' | 'f6' | 'f7' | 'f8' | 'f9' | 'f10' | 'f11' | 'f12'
                | 'f13' | 'f14' | 'f15' | 'f16' | 'f17' | 'f18' | 'f19' | 'f20' | 'f21' | 'f22' | 'f23'
                | 'f24' | 'f25' | 'f26' | 'f27' | 'f28' | 'f29' | 'f30' | 'f31' | 'f32' | 'f33' | 'f34'
                | 'f35' | 'backspace' | 'delete' | 'left' | 'right' | 'up' | 'down' | 'pageup'
                | 'pagedown' | 'insert' | 'home' | 'end' | 'back' | 'forward' | 'escape':
                false;
            case _:
                true;
        }
    }

    @:allow(gpui)
    static function unparseKeystroke(modifiers:Modifiers, key:String, os:OperatingSystem):String {
        final result = new StringBuf();
        if (modifiers.function_) {
            result.add('fn-');
        }
        if (modifiers.control) {
            result.add('ctrl-');
        }
        if (modifiers.alt) {
            result.add('alt-');
        }
        if (modifiers.platform) {
            result.add(switch os {
                case Windows: 'win-';
                case Linux | FreeBsd | Android | Unknown: 'super-';
                case Mac | Ios: 'cmd-';
            });
        }
        if (modifiers.shift) {
            result.add('shift-');
        }
        result.add(key);
        return result.toString();
    }

    @:allow(gpui)
    static function displayKeystroke(modifiers:Modifiers, key:String, os:OperatingSystem):String {
        final result = new StringBuf();
        final mac = os == Mac;
        if (modifiers.control) {
            result.add(mac ? '^' : 'ctrl-');
        }
        if (modifiers.alt) {
            result.add(mac ? '⌥' : 'alt-');
        }
        if (modifiers.platform) {
            result.add(switch os {
                case Mac: '⌘';
                case Windows: '⊞';
                case Linux | FreeBsd: '❖';
                case Ios | Android | Unknown: 'cmd-';
            });
        }
        if (modifiers.shift) {
            result.add(mac ? '⇧' : 'shift-');
        }
        final symbol:Null<String> = !mac ? null : switch key {
            case 'backspace': '⌫';
            case 'up': '↑';
            case 'down': '↓';
            case 'left': '←';
            case 'right': '→';
            case 'tab': '⇥';
            case 'escape': '⎋';
            case 'shift': '⇧';
            case 'control': '⌃';
            case 'alt': '⌥';
            case 'platform': '⌘';
            case _: null;
        }
        if (symbol != null) {
            result.add(symbol);
        }
        else if (key.length == 1 && StringTools.fastCodeAt(key, 0) < 128) {
            // Rust checks a length of one byte, so only ASCII is upper cased
            result.add(asciiUpperCase(key));
        }
        else {
            result.add(key);
        }
        return result.toString();
    }

    static inline function isAsciiUppercase(c:Int):Bool {
        return c >= 'A'.code && c <= 'Z'.code;
    }

    /**
     * Rust `make_ascii_lowercase` / `eq_ignore_ascii_case`: only ASCII letters change.
     */
    @:allow(gpui)
    static function asciiLowerCase(s:String):String {
        var result:Null<StringBuf> = null;
        var last = 0;
        for (i in 0...s.length) {
            final c = StringTools.fastCodeAt(s, i);
            if (isAsciiUppercase(c)) {
                if (result == null) result = new StringBuf();
                result.add(s.substring(last, i));
                result.addChar(c + 32);
                last = i + 1;
            }
        }
        if (result == null) return s;
        result.add(s.substring(last));
        return result.toString();
    }

    static function asciiUpperCase(s:String):String {
        final buf = new StringBuf();
        for (i in 0...s.length) {
            final c = StringTools.fastCodeAt(s, i);
            if (c >= 'a'.code && c <= 'z'.code) {
                buf.addChar(c - 32);
            }
            else {
                buf.add(s.charAt(i));
            }
        }
        return buf.toString();
    }

}
