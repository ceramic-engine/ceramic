package glaze;

/**
 * Registration data of an action, generated by `ActionMacro` (Rust: the
 * `MacroActionData` collected with `inventory`). Implementation detail.
 */
class MacroActionData {

    public final name:String;

    /**
     * Fully qualified class name (Rust: `TypeId`).
     */
    public final typeName:String;

    public final build:(value:Dynamic) -> Action;

    public final deprecatedAliases:Array<String>;

    public final deprecationMessage:Null<String>;

    public final documentation:Null<String>;

    public function new(name:String, typeName:String, build:(value:Dynamic) -> Action, deprecatedAliases:Array<String>, deprecationMessage:Null<String>, documentation:Null<String>) {
        this.name = name;
        this.typeName = typeName;
        this.build = build;
        this.deprecatedAliases = deprecatedAliases;
        this.deprecationMessage = deprecationMessage;
        this.documentation = documentation;
    }

}
