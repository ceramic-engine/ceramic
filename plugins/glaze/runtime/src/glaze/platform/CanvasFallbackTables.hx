    /** Emoji status of a code point (`NON_EMOJI` when not listed) */
    public static function emojiStatus(c:Int):Int {
        final table = EMOJI_STATUS;
        var lo = 0;
        var hi = Std.int(table.length / 3) - 1;
        while (lo <= hi) {
            final mid = (lo + hi) >> 1;
            if (c < table[mid * 3])
                hi = mid - 1;
            else if (c > table[mid * 3 + 1])
                lo = mid + 1;
            else
                return table[mid * 3 + 2];
        }
        return 0;
    }

    /** Whether a code point is a Han letter (script Han, category Lo) */
    public static function isHanLetter(c:Int):Bool {
        final table = HAN_LETTER;
        var lo = 0;
        var hi = (table.length >> 1) - 1;
        while (lo <= hi) {
            final mid = (lo + hi) >> 1;
            if (c < table[mid * 2])
                hi = mid - 1;
            else if (c > table[mid * 2 + 1])
                lo = mid + 1;
            else
                return true;
        }
        return false;
    }

