package glaze.kit;

import glaze.AppContext;
import glaze.IntoElement;
import glaze.RenderOnce;
import glaze.Window;

/**
 * Default component icon names: the 106 icons of gpui-kit's
 * `default-icons.txt` (Lucide icons, ISC, some derived from Feather, MIT,
 * plus a few gpui-kit icons), bundled with the plugin in `resources/icons`
 * (see `resources/icons/LICENSE-LUCIDE.txt`).
 *
 * The variants are generated by `IconNameMacro` from the files of
 * `resources/icons`: `IconName.ChevronDown` is `"icons/chevron-down.svg"`,
 * the path understood by the asset source.
 *
 * **Project icons**: the SVG files of the project's `resources/glaze/icons`
 * get a variant too (`resources/glaze/icons/alarm-clock.svg` is
 * `IconName.AlarmClock`), accepted wherever an icon is. More directories
 * can be listed in `ceramic.yml`:
 *
 * ```yaml
 * app:
 *     glaze:
 *         icons:
 *             - path/to/more/icons
 * ```
 *
 * A file with the name of an icon already added (a bundled one, or one of
 * an earlier directory) replaces it.
 *
 * The content of every icon is embedded in the code at compile time and
 * added to the app's asset source when the kit initializes: icons draw at
 * once on every target, the web included, with nothing to preload.
 */
@:build(glaze.kit.IconNameMacro.build())
enum abstract IconName(String) to String {

    /**
     * The path understood by the bundled asset source.
     */
    public inline function path():String {
        return this;
    }

    /**
     * Rust `IconName::view`: the icon as an `Entity<Icon>`.
     */
    public function view(cx:AppContext):glaze.Entity<Icon.IconView> {
        return Icon.build(this).view(cx);
    }

    /**
     * Rust `impl From<IconName> for AnyElement` / `RenderOnce for IconName`.
     */
    @:to public inline function toIntoElement():IntoElement {
        return (Icon.build(this) : RenderOnce);
    }

    /**
     * Adds the embedded content of every icon to `source` (the kit does it
     * for the asset source of each app it initializes).
     */
    public static function addTo(source:glaze.CeramicAssetSource):Void {
        final svgs = embeddedSvgs();
        for (i in 0...ALL.length) {
            source.add(ALL[i].path(), haxe.io.Bytes.ofString(svgs[i]));
        }
    }

}
