using glaze.kit.base.dock.JsonValue.JsonValueTools;

/**
 * `serde_json::to_string_pretty(&StyleRefinement)` and
 * `serde_json::from_str::<StyleRefinement>` as built by the reference (a
 * release build: `StyleRefinement` has no `debug` fields, so the port's
 * `debug` and `debugBelow` are neither written nor read).
 *
 * Errors are `SerdeError`s with serde_json's messages and positions.
 */
class StyleJson {

    static inline function f32(value:Float):Float {
        return SpringMath.f32(value);
    }

/// Serialize

    /** `serde_json::to_string_pretty(style)` */
    public static function toJson(style:StyleRefinement):String {
        return styleValue(style).stringifyPretty();
    }

    static function obj(entries:Array<{key:String, value:JsonValue}>):JsonValue {
        return JsonValueTools.object(entries);
    }

    static function addIf(entries:Array<{key:String, value:JsonValue}>, key:String, value:Null<JsonValue>):Void {
        if (value != null) entries.push({key: key, value: value});
    }

    /** Serializes a refinement struct field (skipped when empty). */
    static function addObject(entries:Array<{key:String, value:JsonValue}>, key:String, fields:Array<{key:String, value:JsonValue}>):Void {
        if (fields.length > 0) entries.push({key: key, value: obj(fields)});
    }

    static function edges<T>(top:Null<T>, right:Null<T>, bottom:Null<T>, left:Null<T>, write:(T) -> JsonValue):Array<{key:String, value:JsonValue}> {
        final fields = [];
        if (top != null) fields.push({key: 'top', value: write(top)});
        if (right != null) fields.push({key: 'right', value: write(right)});
        if (bottom != null) fields.push({key: 'bottom', value: write(bottom)});
        if (left != null) fields.push({key: 'left', value: write(left)});
        return fields;
    }

    static function sizes<T>(width:Null<T>, height:Null<T>, write:(T) -> JsonValue):Array<{key:String, value:JsonValue}> {
        final fields = [];
        if (width != null) fields.push({key: 'width', value: write(width)});
        if (height != null) fields.push({key: 'height', value: write(height)});
        return fields;
    }

    static function lengthJson(value:Length):JsonValue {
        return JString(lengthDisplay(value));
    }

    static function definiteJson(value:DefiniteLength):JsonValue {
        return JString(definiteDisplay(value));
    }

    static function absoluteJson(value:AbsoluteLength):JsonValue {
        return JString(absoluteDisplay(value));
    }

    /** The JSON value of a style refinement, fields in Rust order. */
    public static function styleValue(style:StyleRefinement):JsonValue {
        final e:Array<{key:String, value:JsonValue}> = [];
        if (style.has(StyleRefinement.DISPLAY)) e.push({key: 'display', value: JString(displayName(style.display))});
        if (style.has(StyleRefinement.VISIBILITY)) e.push({key: 'visibility', value: JString(visibilityName(style.visibility))});
        final overflow = [];
        if (style.has(StyleRefinement.OVERFLOW_X)) overflow.push({key: 'x', value: JString(overflowName(style.overflowX))});
        if (style.has(StyleRefinement.OVERFLOW_Y)) overflow.push({key: 'y', value: JString(overflowName(style.overflowY))});
        addObject(e, 'overflow', overflow);
        if (style.scrollbarWidth != null) e.push({key: 'scrollbar_width', value: absoluteJson(style.scrollbarWidth)});
        if (style.has(StyleRefinement.ALLOW_CONCURRENT_SCROLL)) e.push({key: 'allow_concurrent_scroll', value: JBool(style.allowConcurrentScroll)});
        if (style.has(StyleRefinement.RESTRICT_SCROLL_TO_AXIS)) e.push({key: 'restrict_scroll_to_axis', value: JBool(style.restrictScrollToAxis)});
        if (style.has(StyleRefinement.POSITION)) e.push({key: 'position', value: JString(positionName(style.position))});
        addObject(e, 'inset', edges(style.insetTop, style.insetRight, style.insetBottom, style.insetLeft, lengthJson));
        addObject(e, 'size', sizes(style.sizeWidth, style.sizeHeight, lengthJson));
        addObject(e, 'min_size', sizes(style.minSizeWidth, style.minSizeHeight, lengthJson));
        addObject(e, 'max_size', sizes(style.maxSizeWidth, style.maxSizeHeight, lengthJson));
        if (style.has(StyleRefinement.ASPECT_RATIO)) e.push({key: 'aspect_ratio', value: JFloat32(style.aspectRatio)});
        addObject(e, 'margin', edges(style.marginTop, style.marginRight, style.marginBottom, style.marginLeft, lengthJson));
        addObject(e, 'padding', edges(style.paddingTop, style.paddingRight, style.paddingBottom, style.paddingLeft, definiteJson));
        addObject(e, 'border_widths', edges(style.borderWidthTop, style.borderWidthRight, style.borderWidthBottom, style.borderWidthLeft, absoluteJson));
        if (style.has(StyleRefinement.ALIGN_ITEMS)) e.push({key: 'align_items', value: JString(alignItemsName(style.alignItems))});
        if (style.has(StyleRefinement.ALIGN_SELF)) e.push({key: 'align_self', value: JString(alignItemsName(style.alignSelf))});
        if (style.has(StyleRefinement.ALIGN_CONTENT)) e.push({key: 'align_content', value: JString(alignContentName(style.alignContent))});
        if (style.has(StyleRefinement.JUSTIFY_CONTENT)) e.push({key: 'justify_content', value: JString(alignContentName(style.justifyContent))});
        addObject(e, 'gap', sizes(style.gapWidth, style.gapHeight, definiteJson));
        if (style.has(StyleRefinement.FLEX_DIRECTION)) e.push({key: 'flex_direction', value: JString(flexDirectionName(style.flexDirection))});
        if (style.has(StyleRefinement.FLEX_WRAP)) e.push({key: 'flex_wrap', value: JString(flexWrapName(style.flexWrap))});
        if (style.flexBasis != null) e.push({key: 'flex_basis', value: lengthJson(style.flexBasis)});
        if (style.has(StyleRefinement.FLEX_GROW)) e.push({key: 'flex_grow', value: JFloat32(style.flexGrow)});
        if (style.has(StyleRefinement.FLEX_SHRINK)) e.push({key: 'flex_shrink', value: JFloat32(style.flexShrink)});
        if (style.background != null) e.push({key: 'background', value: obj([{key: 'Color', value: backgroundValue(style.background)}])});
        if (style.borderColor != null) e.push({key: 'border_color', value: hslaJson(style.borderColor)});
        if (style.has(StyleRefinement.BORDER_STYLE)) e.push({key: 'border_style', value: JString(style.borderStyle == glaze.scene.BorderStyle.Dashed ? 'Dashed' : 'Solid')});
        final corners = [];
        if (style.cornerRadiusTopLeft != null) corners.push({key: 'top_left', value: absoluteJson(style.cornerRadiusTopLeft)});
        if (style.cornerRadiusTopRight != null) corners.push({key: 'top_right', value: absoluteJson(style.cornerRadiusTopRight)});
        if (style.cornerRadiusBottomRight != null) corners.push({key: 'bottom_right', value: absoluteJson(style.cornerRadiusBottomRight)});
        if (style.cornerRadiusBottomLeft != null) corners.push({key: 'bottom_left', value: absoluteJson(style.cornerRadiusBottomLeft)});
        addObject(e, 'corner_radii', corners);
        if (style.boxShadow != null) e.push({key: 'box_shadow', value: JArray([for (shadow in style.boxShadow) boxShadowValue(shadow)])});
        if (style.text != null) addObject(e, 'text', textFields(style.text));
        if (style.has(StyleRefinement.MOUSE_CURSOR)) e.push({key: 'mouse_cursor', value: JString(CURSOR_STYLES[cast style.mouseCursor])});
        if (style.has(StyleRefinement.OPACITY)) e.push({key: 'opacity', value: JFloat32(style.opacity)});
        if (style.gridCols != null) e.push({key: 'grid_cols', value: gridTemplateValue(style.gridCols)});
        if (style.gridRows != null) e.push({key: 'grid_rows', value: gridTemplateValue(style.gridRows)});
        if (style.gridLocation != null) e.push({key: 'grid_location', value: gridLocationValue(style.gridLocation)});
        return obj(e);
    }

    static function textFields(text:TextStyleRefinement):Array<{key:String, value:JsonValue}> {
        final e:Array<{key:String, value:JsonValue}> = [];
        if (text.color != null) e.push({key: 'color', value: hslaJson(text.color)});
        if (text.fontFamily != null) e.push({key: 'font_family', value: JString(text.fontFamily)});
        if (text.fontFeatures != null) {
            final features = new JsonObject();
            for (i in 0...text.fontFeatures.tags.length) {
                features.set(text.fontFeatures.tags[i], JInt(text.fontFeatures.values[i]));
            }
            e.push({key: 'font_features', value: JObject(features)});
        }
        if (text.fontFallbacks != null) e.push({key: 'font_fallbacks', value: JArray([for (font in text.fontFallbacks.fallbackList()) JString(font)])});
        if (text.fontSize != null) e.push({key: 'font_size', value: absoluteJson(text.fontSize)});
        if (text.lineHeight != null) e.push({key: 'line_height', value: definiteJson(text.lineHeight)});
        if (text.has(TextStyleRefinement.FONT_WEIGHT)) e.push({key: 'font_weight', value: JFloat32(text.fontWeight)});
        if (text.has(TextStyleRefinement.FONT_STYLE)) e.push({key: 'font_style', value: JString(fontStyleName(text.fontStyle))});
        if (text.backgroundColor != null) e.push({key: 'background_color', value: hslaJson(text.backgroundColor)});
        if (text.underline != null) {
            e.push({key: 'underline', value: obj([
                {key: 'thickness', value: JFloat32(text.underline.thickness)},
                {key: 'color', value: text.underline.color != null ? hslaJson(text.underline.color) : JNull},
                {key: 'wavy', value: JBool(text.underline.wavy)}
            ])});
        }
        if (text.strikethrough != null) {
            e.push({key: 'strikethrough', value: obj([
                {key: 'thickness', value: JFloat32(text.strikethrough.thickness)},
                {key: 'color', value: text.strikethrough.color != null ? hslaJson(text.strikethrough.color) : JNull}
            ])});
        }
        if (text.has(TextStyleRefinement.WHITE_SPACE)) e.push({key: 'white_space', value: JString(text.whiteSpace == Nowrap ? 'Nowrap' : 'Normal')});
        if (text.textOverflow != null) {
            e.push({key: 'text_overflow', value: switch text.textOverflow {
                case Truncate(s): obj([{key: 'Truncate', value: JString(s)}]);
                case TruncateStart(s): obj([{key: 'TruncateStart', value: JString(s)}]);
                case TruncateMiddle(s): obj([{key: 'TruncateMiddle', value: JString(s)}]);
            }});
        }
        if (text.has(TextStyleRefinement.TEXT_ALIGN)) e.push({key: 'text_align', value: JString(textAlignName(text.textAlign))});
        if (text.has(TextStyleRefinement.LINE_CLAMP)) e.push({key: 'line_clamp', value: JInt(text.lineClamp)});
        return e;
    }

    static function backgroundValue(background:Background):JsonValue {
        return obj([
            {key: 'tag', value: JString(BACKGROUND_TAGS[cast background.tag])},
            {key: 'color_space', value: JString(background.colorSpace == Oklab ? 'Oklab' : 'Srgb')},
            {key: 'solid', value: hslaJson(background.solid)},
            {key: 'gradient_angle_or_pattern_height', value: JFloat32(background.gradientAngleOrPatternHeight)},
            {key: 'colors', value: JArray([colorStopValue(background.colors0), colorStopValue(background.colors1)])},
            {key: 'pad', value: JInt(0)}
        ]);
    }

    static function colorStopValue(stop:LinearColorStop):JsonValue {
        return obj([{key: 'color', value: hslaJson(stop.color)}, {key: 'percentage', value: JFloat32(stop.percentage)}]);
    }

    static function boxShadowValue(shadow:BoxShadow):JsonValue {
        return obj([
            {key: 'color', value: hslaJson(shadow.color)},
            {key: 'offset', value: obj([{key: 'x', value: JFloat32(shadow.offset.x)}, {key: 'y', value: JFloat32(shadow.offset.y)}])},
            {key: 'blur_radius', value: JFloat32(shadow.blurRadius)},
            {key: 'spread_radius', value: JFloat32(shadow.spreadRadius)},
            {key: 'inset', value: JBool(shadow.inset)}
        ]);
    }

    static function gridTemplateValue(template:GridTemplate):JsonValue {
        return obj([{key: 'repeat', value: JInt(template.repeat)}, {key: 'min_size', value: JString(GRID_MIN_SIZES[cast template.minSize])}]);
    }

    static function placementValue(placement:GridPlacement):JsonValue {
        return switch placement {
            case Line(index): obj([{key: 'Line', value: JInt(index)}]);
            case Span(span): obj([{key: 'Span', value: JInt(span)}]);
            case Auto: JString('Auto');
        }
    }

    static function gridLocationValue(location:GridLocation):JsonValue {
        return obj([
            {key: 'row', value: obj([{key: 'start', value: placementValue(location.rowStart)}, {key: 'end', value: placementValue(location.rowEnd)}])},
            {key: 'column', value: obj([{key: 'start', value: placementValue(location.columnStart)}, {key: 'end', value: placementValue(location.columnEnd)}])}
        ]);
    }

/// Displays (Rust `Display` of the lengths, `Serialize` of the colors)

    /** Rust `format!("{}", length)` */
    public static function lengthDisplay(value:Length):String {
        return switch value {
            case Definite(definite): definiteDisplay(definite);
            case Auto: 'auto';
        }
    }

    public static function definiteDisplay(value:DefiniteLength):String {
        return switch value {
            case Absolute(length): absoluteDisplay(length);
            // Rust `(fraction * 100.0) as i32`
            case Fraction(fraction): Std.string(saturatingI32(f32(f32(fraction) * 100.0))) + '%';
        }
    }

    public static function absoluteDisplay(value:AbsoluteLength):String {
        return switch value {
            case Pixels(pixels): f32Display(pixels) + 'px';
            case Rems(rems): f32Display(rems) + 'rem';
        }
    }

    /**
     * Rust `format!("{}", value)` of an `f32`: the shortest digits that read
     * back as the same `f32`, written without exponent (`123456790`, `0.1`,
     * `0.0000001`, `-0`).
     */
    public static function f32Display(value:Float):String {
        final v = f32(value);
        if (Math.isNaN(v)) return 'NaN';
        if (!Math.isFinite(v)) return v > 0 ? 'inf' : '-inf';
        final negative = v < 0 || (v == 0 && 1 / v < 0);
        final sign = negative ? '-' : '';
        final abs = Math.abs(v);
        if (abs == 0) return sign + '0';
        final shortest:{digits:String, exp:Int} = @:privateAccess JsonValueTools.shortestDigits(abs, true);
        final digits = shortest.digits;
        final exp = shortest.exp;
        final length = digits.length;
        final zeros = (count:Int) -> StringTools.lpad('', '0', count);
        if (length - 1 <= exp) {
            return sign + digits + zeros(exp - (length - 1));
        }
        else if (exp >= 0) {
            return sign + digits.substr(0, exp + 1) + '.' + digits.substr(exp + 1);
        }
        else {
            return sign + '0.' + zeros(-exp - 1) + digits;
        }
    }

    static function saturatingI32(value:Float):Int {
        if (Math.isNaN(value)) return 0;
        if (value >= 2147483647.0) return 2147483647;
        if (value <= -2147483648.0) return -2147483648;
        return Std.int(value);
    }

    static function saturatingU8(value:Float):Int {
        if (Math.isNaN(value) || value <= 0) return 0;
        if (value >= 255) return 255;
        return Std.int(value);
    }

    /** Rust `f32::round`: half away from zero */
    static function roundF32(value:Float):Float {
        return value < 0 ? -Math.ffloor(-value + 0.5) : Math.ffloor(value + 0.5);
    }

    /** `Serialize for Hsla`: the `Rgba` it converts to, as `#rrggbbaa` (f32 arithmetic). */
    public static function hslaHex(color:Hsla):String {
        final rgba = hslaToRgba(color);
        final hex = (v:Float) -> StringTools.hex(saturatingU8(roundF32(f32(v * 255.0))), 2).toLowerCase();
        return '#' + hex(rgba[0]) + hex(rgba[1]) + hex(rgba[2]) + hex(rgba[3]);
    }

    static function hslaJson(color:Hsla):JsonValue {
        return JString(hslaHex(color));
    }

    /** `From<Hsla> for Rgba` with f32 arithmetic: `[r, g, b, a]`. */
    static function hslaToRgba(color:Hsla):Array<Float> {
        final h = f32(color.h);
        final s = f32(color.s);
        final l = f32(color.l);
        final c = f32(f32(1.0 - Math.abs(f32(f32(2.0 * l) - 1.0))) * s);
        final x = f32(c * f32(1.0 - Math.abs(f32(f32(f32(h * 6.0) % 2.0) - 1.0))));
        final m = f32(l - f32(c / 2.0));
        final cm = f32(c + m);
        final xm = f32(x + m);
        final sector = Math.ffloor(f32(h * 6.0));
        final rgb = switch (Math.isNaN(sector) ? 0 : saturatingI32(sector)) {
            case 0 | 6: [cm, xm, m];
            case 1: [xm, cm, m];
            case 2: [m, cm, xm];
            case 3: [m, xm, cm];
            case 4: [xm, m, cm];
            case _: [cm, m, xm];
        }
        final clamp = (v:Float) -> v < 0 ? 0.0 : (v > 1 ? 1.0 : v);
        return [clamp(rgb[0]), clamp(rgb[1]), clamp(rgb[2]), f32(color.a)];
    }

    /** `From<Rgba> for Hsla` with f32 arithmetic. */
    static function rgbaToHsla(r:Float, g:Float, b:Float, a:Float):Hsla {
        final max = Math.max(r, Math.max(g, b));
        final min = Math.min(r, Math.min(g, b));
        final delta = f32(max - min);
        final l = f32(f32(max + min) / 2.0);
        final s = if (l == 0.0 || l == 1.0) {
            0.0;
        }
        else if (l < 0.5) {
            f32(delta / f32(2.0 * l));
        }
        else {
            f32(delta / f32(2.0 - f32(2.0 * l)));
        }
        final h = if (delta == 0.0) {
            0.0;
        }
        else if (max == r) {
            final q = f32(f32(g - b) / delta);
            var rem = q % 6.0;
            if (rem < 0) rem = f32(rem + 6.0);
            f32(rem / 6.0);
        }
        else if (max == g) {
            f32(f32(f32(f32(b - r) / delta) + 2.0) / 6.0);
        }
        else {
            f32(f32(f32(f32(r - g) / delta) + 4.0) / 6.0);
        }
        return new Hsla(h, s, l, a);
    }

/// Names of the enums (Rust variant names)

    static final DISPLAYS = ['Block', 'Flex', 'Grid', 'None'];
    static final VISIBILITIES = ['Visible', 'Hidden'];
    static final OVERFLOWS = ['Visible', 'Clip', 'Hidden', 'Scroll'];
    static final POSITIONS = ['Relative', 'Absolute'];
    static final FLEX_DIRECTIONS = ['Row', 'Column', 'RowReverse', 'ColumnReverse'];
    static final FLEX_WRAPS = ['NoWrap', 'Wrap', 'WrapReverse'];
    static final ALIGN_ITEMS = ['Start', 'End', 'FlexStart', 'FlexEnd', 'Center', 'Baseline', 'Stretch'];
    static final ALIGN_CONTENTS = ['Start', 'End', 'FlexStart', 'FlexEnd', 'Center', 'Stretch', 'SpaceBetween', 'SpaceEvenly', 'SpaceAround'];
    static final BORDER_STYLES = ['Solid', 'Dashed'];
    static final FONT_STYLES = ['Normal', 'Italic', 'Oblique'];
    static final WHITE_SPACES = ['Normal', 'Nowrap'];
    static final TEXT_ALIGNS = ['Left', 'Center', 'Right'];
    static final CURSOR_STYLES = ['Arrow', 'IBeam', 'Crosshair', 'ClosedHand', 'OpenHand', 'PointingHand', 'ResizeLeft', 'ResizeRight', 'ResizeLeftRight', 'ResizeUp',
        'ResizeDown', 'ResizeUpDown', 'ResizeUpLeftDownRight', 'ResizeUpRightDownLeft', 'ResizeColumn', 'ResizeRow', 'IBeamCursorForVerticalLayout',
        'OperationNotAllowed', 'DragLink', 'DragCopy', 'ContextualMenu'];
    static final GRID_MIN_SIZES = ['Zero', 'MinContent', 'MaxContent'];
    static final COLOR_SPACES = ['Srgb', 'Oklab'];
    static final BACKGROUND_TAGS = ['Solid', 'LinearGradient', 'PatternSlash', 'Checkerboard'];
    static final TEXT_OVERFLOWS = ['Truncate', 'TruncateStart', 'TruncateMiddle'];
    static final GRID_PLACEMENTS = ['Line', 'Span', 'Auto'];
    static final FILLS = ['Color'];

    static inline function displayName(v:Display):String return DISPLAYS[cast v];
    static inline function visibilityName(v:Visibility):String return VISIBILITIES[cast v];
    static inline function overflowName(v:Overflow):String return OVERFLOWS[cast v];
    static inline function positionName(v:Position):String return POSITIONS[cast v];
    static inline function flexDirectionName(v:FlexDirection):String return FLEX_DIRECTIONS[cast v];
    static inline function flexWrapName(v:FlexWrap):String return FLEX_WRAPS[cast v];
    static inline function alignItemsName(v:AlignItems):String return ALIGN_ITEMS[cast v];
    static inline function alignContentName(v:AlignContent):String return ALIGN_CONTENTS[cast v];
    static inline function fontStyleName(v:FontStyle):String return FONT_STYLES[cast v];
    static inline function textAlignName(v:TextAlign):String return TEXT_ALIGNS[cast v];

/// Deserialize

    /**
     * `serde_json::from_str::<StyleRefinement>(text)`: throws a `SerdeError`.
     */
    public static function fromJson(text:String):StyleRefinement {
        final r = new SerdeReader(text);
        final style = deStyle(r);
        r.end();
        return style;
    }

    static final STYLE_FIELDS = ['display', 'visibility', 'overflow', 'scrollbar_width', 'allow_concurrent_scroll', 'restrict_scroll_to_axis', 'position',
        'inset', 'size', 'min_size', 'max_size', 'aspect_ratio', 'margin', 'padding', 'border_widths', 'align_items', 'align_self', 'align_content',
        'justify_content', 'gap', 'flex_direction', 'flex_wrap', 'flex_basis', 'flex_grow', 'flex_shrink', 'background', 'border_color', 'border_style',
        'corner_radii', 'box_shadow', 'text', 'mouse_cursor', 'opacity', 'grid_cols', 'grid_rows', 'grid_location'];

    /** Fields with `#[serde(default)]` (the refinement fields) */
    static final STYLE_DEFAULTS = ['overflow', 'inset', 'size', 'min_size', 'max_size', 'margin', 'padding', 'border_widths', 'gap', 'corner_radii', 'text'];

    static function deStyle(r:SerdeReader):StyleRefinement {
        final style = new StyleRefinement();
        deStruct(r, 'struct StyleRefinement', STYLE_FIELDS, STYLE_DEFAULTS, [], (field) -> {
            switch field {
                case 'display': option(r, () -> style.display = cast unitEnum(r, DISPLAYS));
                case 'visibility': option(r, () -> style.visibility = cast unitEnum(r, VISIBILITIES));
                case 'overflow':
                    deStruct(r, 'struct PointRefinement', ['x', 'y'], [], [], (f) -> {
                        option(r, () -> {
                            final v:Overflow = cast unitEnum(r, OVERFLOWS);
                            if (f == 'x') style.overflowX = v else style.overflowY = v;
                        });
                    });
                case 'scrollbar_width': option(r, () -> style.scrollbarWidth = deAbsolute(r));
                case 'allow_concurrent_scroll': option(r, () -> style.allowConcurrentScroll = deBool(r));
                case 'restrict_scroll_to_axis': option(r, () -> style.restrictScrollToAxis = deBool(r));
                case 'position': option(r, () -> style.position = cast unitEnum(r, POSITIONS));
                case 'inset':
                    deEdges(r, 'struct EdgesRefinement', () -> deLength(r), (t, ri, b, l) -> {
                        style.insetTop = t; style.insetRight = ri; style.insetBottom = b; style.insetLeft = l;
                    });
                case 'size': deSize(r, () -> deLength(r), (w, h) -> { style.sizeWidth = w; style.sizeHeight = h; });
                case 'min_size': deSize(r, () -> deLength(r), (w, h) -> { style.minSizeWidth = w; style.minSizeHeight = h; });
                case 'max_size': deSize(r, () -> deLength(r), (w, h) -> { style.maxSizeWidth = w; style.maxSizeHeight = h; });
                case 'aspect_ratio': option(r, () -> style.aspectRatio = deF32(r));
                case 'margin':
                    deEdges(r, 'struct EdgesRefinement', () -> deLength(r), (t, ri, b, l) -> {
                        style.marginTop = t; style.marginRight = ri; style.marginBottom = b; style.marginLeft = l;
                    });
                case 'padding':
                    deEdges(r, 'struct EdgesRefinement', () -> deDefinite(r), (t, ri, b, l) -> {
                        style.paddingTop = t; style.paddingRight = ri; style.paddingBottom = b; style.paddingLeft = l;
                    });
                case 'border_widths':
                    deEdges(r, 'struct EdgesRefinement', () -> deAbsolute(r), (t, ri, b, l) -> {
                        style.borderWidthTop = t; style.borderWidthRight = ri; style.borderWidthBottom = b; style.borderWidthLeft = l;
                    });
                case 'align_items': option(r, () -> style.alignItems = cast unitEnum(r, ALIGN_ITEMS));
                case 'align_self': option(r, () -> style.alignSelf = cast unitEnum(r, ALIGN_ITEMS));
                case 'align_content': option(r, () -> style.alignContent = cast unitEnum(r, ALIGN_CONTENTS));
                case 'justify_content': option(r, () -> style.justifyContent = cast unitEnum(r, ALIGN_CONTENTS));
                case 'gap': deSize(r, () -> deDefinite(r), (w, h) -> { style.gapWidth = w; style.gapHeight = h; });
                case 'flex_direction': option(r, () -> style.flexDirection = cast unitEnum(r, FLEX_DIRECTIONS));
                case 'flex_wrap': option(r, () -> style.flexWrap = cast unitEnum(r, FLEX_WRAPS));
                case 'flex_basis': option(r, () -> style.flexBasis = deLength(r));
                case 'flex_grow': option(r, () -> style.flexGrow = deF32(r));
                case 'flex_shrink': option(r, () -> style.flexShrink = deF32(r));
                case 'background': option(r, () -> style.background = deFill(r));
                case 'border_color': option(r, () -> style.borderColor = deHsla(r));
                case 'border_style': option(r, () -> style.borderStyle = cast unitEnum(r, BORDER_STYLES));
                case 'corner_radii':
                    var tl:Null<AbsoluteLength> = null, tr:Null<AbsoluteLength> = null, br:Null<AbsoluteLength> = null, bl:Null<AbsoluteLength> = null;
                    deStruct(r, 'struct CornersRefinement', ['top_left', 'top_right', 'bottom_right', 'bottom_left'], [], [], (f) -> {
                        option(r, () -> {
                            final v = deAbsolute(r);
                            switch f {
                                case 'top_left': tl = v;
                                case 'top_right': tr = v;
                                case 'bottom_right': br = v;
                                case _: bl = v;
                            }
                        });
                    });
                    style.cornerRadiusTopLeft = tl;
                    style.cornerRadiusTopRight = tr;
                    style.cornerRadiusBottomRight = br;
                    style.cornerRadiusBottomLeft = bl;
                case 'box_shadow': option(r, () -> style.boxShadow = deSeq(r, () -> deBoxShadow(r)));
                case 'text':
                    final text = deText(r);
                    style.text = text.isSome() ? text : null;
                case 'mouse_cursor': option(r, () -> style.mouseCursor = cast unitEnum(r, CURSOR_STYLES));
                case 'opacity': option(r, () -> style.opacity = deF32(r));
                case 'grid_cols': option(r, () -> style.gridCols = deGridTemplate(r));
                case 'grid_rows': option(r, () -> style.gridRows = deGridTemplate(r));
                case 'grid_location': option(r, () -> style.gridLocation = deGridLocation(r));
                case _:
            }
        });
        return style;
    }

    static final TEXT_FIELDS = ['color', 'font_family', 'font_features', 'font_fallbacks', 'font_size', 'line_height', 'font_weight', 'font_style',
        'background_color', 'underline', 'strikethrough', 'white_space', 'text_overflow', 'text_align', 'line_clamp'];

    static function deText(r:SerdeReader):TextStyleRefinement {
        final text = new TextStyleRefinement();
        deStruct(r, 'struct TextStyleRefinement', TEXT_FIELDS, [], [], (field) -> {
            switch field {
                case 'color': option(r, () -> text.color = deHsla(r));
                case 'font_family': option(r, () -> text.fontFamily = deString(r));
                case 'font_features': option(r, () -> text.fontFeatures = deFontFeatures(r));
                case 'font_fallbacks': option(r, () -> text.fontFallbacks = FontFallbacks.fromFonts(deSeq(r, () -> deString(r))));
                case 'font_size': option(r, () -> text.fontSize = deAbsolute(r));
                case 'line_height': option(r, () -> text.lineHeight = deDefinite(r));
                case 'font_weight': option(r, () -> text.fontWeight = deF32(r));
                case 'font_style': option(r, () -> text.fontStyle = cast unitEnum(r, FONT_STYLES));
                case 'background_color': option(r, () -> text.backgroundColor = deHsla(r));
                case 'underline': option(r, () -> text.underline = deUnderline(r));
                case 'strikethrough': option(r, () -> text.strikethrough = deStrikethrough(r));
                case 'white_space': option(r, () -> text.whiteSpace = cast unitEnum(r, WHITE_SPACES));
                case 'text_overflow': option(r, () -> text.textOverflow = deTextOverflow(r));
                case 'text_align': option(r, () -> text.textAlign = cast unitEnum(r, TEXT_ALIGNS));
                case 'line_clamp': option(r, () -> text.lineClamp = deUnsigned(r, 'usize', 18446744073709551615.0));
                case _:
            }
        });
        return text;
    }

    static function deEdges<T>(r:SerdeReader, name:String, value:() -> T, done:(Null<T>, Null<T>, Null<T>, Null<T>) -> Void):Void {
        // Typed T, not Null<T>: Haxe's C# output cannot read a captured Null<T> of a type parameter
        var top:T = null, right:T = null, bottom:T = null, left:T = null;
        deStruct(r, name, ['top', 'right', 'bottom', 'left'], [], [], (f) -> {
            option(r, () -> {
                final v = value();
                switch f {
                    case 'top': top = v;
                    case 'right': right = v;
                    case 'bottom': bottom = v;
                    case _: left = v;
                }
            });
        });
        done(top, right, bottom, left);
    }

    static function deSize<T>(r:SerdeReader, value:() -> T, done:(Null<T>, Null<T>) -> Void):Void {
        // Typed T, not Null<T>: Haxe's C# output cannot read a captured Null<T> of a type parameter
        var width:T = null, height:T = null;
        deStruct(r, 'struct SizeRefinement', ['width', 'height'], [], [], (f) -> {
            option(r, () -> {
                final v = value();
                if (f == 'width') width = v else height = v;
            });
        });
        done(width, height);
    }

    static function deBoxShadow(r:SerdeReader):BoxShadow {
        var color:Hsla = null;
        var offset:Point = null;
        var blur:Float = 0;
        var spread:Float = 0;
        var inset = false;
        final fields = ['color', 'offset', 'blur_radius', 'spread_radius', 'inset'];
        deStruct(r, 'struct BoxShadow', fields, [], fields, (f) -> {
            switch f {
                case 'color': color = deHsla(r);
                case 'offset': offset = dePoint(r);
                case 'blur_radius': blur = deF32(r);
                case 'spread_radius': spread = deF32(r);
                case _: inset = deBool(r);
            }
        });
        final shadow = new BoxShadow(offset.x, offset.y, color);
        shadow.blurRadius = blur;
        shadow.spreadRadius = spread;
        shadow.inset = inset;
        return shadow;
    }

    static function dePoint(r:SerdeReader):Point {
        var x:Float = 0;
        var y:Float = 0;
        deStruct(r, 'struct Point', ['x', 'y'], [], ['x', 'y'], (f) -> {
            if (f == 'x') x = deF32(r) else y = deF32(r);
        });
        return new Point(x, y);
    }

    static function deUnderline(r:SerdeReader):UnderlineStyle {
        var thickness:Float = 0;
        var color:Null<Hsla> = null;
        var wavy = false;
        deStruct(r, 'struct UnderlineStyle', ['thickness', 'color', 'wavy'], [], ['thickness', 'wavy'], (f) -> {
            switch f {
                case 'thickness': thickness = deF32(r);
                case 'color': option(r, () -> color = deHsla(r));
                case _: wavy = deBool(r);
            }
        });
        return new UnderlineStyle(thickness, color, wavy);
    }

    static function deStrikethrough(r:SerdeReader):StrikethroughStyle {
        var thickness:Float = 0;
        var color:Null<Hsla> = null;
        deStruct(r, 'struct StrikethroughStyle', ['thickness', 'color'], [], ['thickness'], (f) -> {
            if (f == 'thickness') thickness = deF32(r) else option(r, () -> color = deHsla(r));
        });
        return new StrikethroughStyle(thickness, color);
    }

    static function deGridTemplate(r:SerdeReader):GridTemplate {
        var repeat = 0;
        var minSize:GridTemplateMinSize = Zero;
        deStruct(r, 'struct GridTemplate', ['repeat', 'min_size'], [], ['repeat', 'min_size'], (f) -> {
            if (f == 'repeat') repeat = deUnsigned(r, 'u16', 65535) else minSize = cast unitEnum(r, GRID_MIN_SIZES);
        });
        return new GridTemplate(repeat, minSize);
    }

    static function deGridLocation(r:SerdeReader):GridLocation {
        final location = new GridLocation();
        deStruct(r, 'struct GridLocation', ['row', 'column'], [], ['row', 'column'], (f) -> {
            final range = deRange(r);
            if (f == 'row') {
                location.rowStart = range[0];
                location.rowEnd = range[1];
            }
            else {
                location.columnStart = range[0];
                location.columnEnd = range[1];
            }
        });
        return location;
    }

    /** serde's `Range<GridPlacement>` (unknown fields are errors) */
    static function deRange(r:SerdeReader):Array<GridPlacement> {
        var start:GridPlacement = Auto;
        var end:GridPlacement = Auto;
        deStruct(r, 'struct Range', ['start', 'end'], [], ['start', 'end'], (f) -> {
            if (f == 'start') start = dePlacement(r) else end = dePlacement(r);
        }, true);
        return [start, end];
    }

    static function dePlacement(r:SerdeReader):GridPlacement {
        return deEnum(r, GRID_PLACEMENTS, (variant, newtype) -> switch variant {
            case 'Line': GridPlacement.Line(newtype(() -> deSigned(r, 'i16', -32768, 32767)));
            case 'Span': GridPlacement.Span(newtype(() -> deUnsigned(r, 'u16', 65535)));
            case _: GridPlacement.Auto;
        }, ['Auto']);
    }

    static function deTextOverflow(r:SerdeReader):TextOverflow {
        return deEnum(r, TEXT_OVERFLOWS, (variant, newtype) -> switch variant {
            case 'Truncate': TextOverflow.Truncate(newtype(() -> deString(r)));
            case 'TruncateStart': TextOverflow.TruncateStart(newtype(() -> deString(r)));
            case _: TextOverflow.TruncateMiddle(newtype(() -> deString(r)));
        }, []);
    }

    static function deFill(r:SerdeReader):Background {
        return deEnum(r, FILLS, (variant, newtype) -> newtype(() -> deBackground(r)), []);
    }

    static function deBackground(r:SerdeReader):Background {
        var tag:BackgroundTag = Solid;
        var colorSpace:ColorSpace = Srgb;
        var solid:Hsla = null;
        var angle:Float = 0;
        var colors:Array<LinearColorStop> = null;
        final fields = ['tag', 'color_space', 'solid', 'gradient_angle_or_pattern_height', 'colors', 'pad'];
        deStruct(r, 'struct Background', fields, [], fields, (f) -> {
            switch f {
                case 'tag': tag = cast unitEnum(r, BACKGROUND_TAGS);
                case 'color_space': colorSpace = cast unitEnum(r, COLOR_SPACES);
                case 'solid': solid = deHsla(r);
                case 'gradient_angle_or_pattern_height': angle = deF32(r);
                case 'colors': colors = deArray2(r, () -> deColorStop(r));
                case _: deUnsigned(r, 'u32', 4294967295.0);
            }
        });
        return new Background(tag, colorSpace, solid, angle, colors[0], colors[1]);
    }

    static function deColorStop(r:SerdeReader):LinearColorStop {
        var color:Hsla = null;
        var percentage:Float = 0;
        deStruct(r, 'struct LinearColorStop', ['color', 'percentage'], [], ['color', 'percentage'], (f) -> {
            if (f == 'color') color = deHsla(r) else percentage = deF32(r);
        });
        return new LinearColorStop(color, percentage);
    }

    static function deFontFeatures(r:SerdeReader):FontFeatures {
        final tags:Array<String> = [];
        final values:Array<Int> = [];
        final peek = r.parseWhitespace();
        if (peek == -1) throw r.peekError(SerdeReader.EOF_WHILE_PARSING_VALUE);
        if (peek != '{'.code) throw r.peekInvalidType('a map of font features');
        r.eatChar();
        var err:Null<SerdeError> = null;
        try {
            final first = new glaze.util.Ref(true);
            while (true) {
                final key = nextKey(r, first);
                if (key == null) break;
                r.parseObjectColon();
                // `Option<FeatureValue>`, an untagged enum of a boolean or a number
                var value:Null<Float> = null;
                var valid = true;
                switch r.parseWhitespace() {
                    case 'n'.code:
                        r.eatChar();
                        r.parseIdent('ull');
                        continue;
                    case 't'.code:
                        r.eatChar();
                        r.parseIdent('rue');
                        value = 1;
                    case 'f'.code:
                        r.eatChar();
                        r.parseIdent('alse');
                        value = 0;
                    case c if (c == '-'.code || (c >= '0'.code && c <= '9'.code)):
                        if (c == '-'.code) r.eatChar();
                        switch r.parseInteger(c != '-'.code) {
                            case U64(v): value = v;
                            case _: valid = false;
                        }
                    case _:
                        r.ignoreValue();
                        throw SerdeError.custom('data did not match any variant of untagged enum FeatureValue');
                }
                if (!FontFeatures.isValidFeatureTag(key) || !valid) {
                    continue;
                }
                tags.push(key);
                // Rust `as u32`
                values.push(Std.int(value % 4294967296.0));
            }
        }
        catch (e:SerdeError) {
            err = e;
        }
        try {
            r.endMap();
        }
        catch (e:SerdeError) {
            if (err == null) err = e;
        }
        if (err != null) throw r.fixPosition(err);
        return FontFeatures.fromList(tags, values);
    }

/// Generic visitors (serde derive and serde_json)

    /**
     * `has_next_key` and the key string of serde_json's `MapAccess`, or
     * `null` at the end of the map.
     */
    static function nextKey(r:SerdeReader, first:glaze.util.Ref<Bool>):Null<String> {
        final peek = r.parseWhitespace();
        if (peek == -1) {
            throw r.peekError(SerdeReader.EOF_WHILE_PARSING_OBJECT);
        }
        if (peek == '}'.code) {
            return null;
        }
        else if (first.value) {
            first.value = false;
            if (peek != '"'.code) {
                throw r.peekError(SerdeReader.KEY_MUST_BE_A_STRING);
            }
        }
        else if (peek == ','.code) {
            r.eatChar();
            switch r.parseWhitespace() {
                case '"'.code:
                case '}'.code: throw r.peekError(SerdeReader.TRAILING_COMMA);
                case -1: throw r.peekError(SerdeReader.EOF_WHILE_PARSING_VALUE);
                case _: throw r.peekError(SerdeReader.KEY_MUST_BE_A_STRING);
            }
        }
        else {
            throw r.peekError(SerdeReader.EXPECTED_OBJECT_COMMA_OR_END);
        }
        r.eatChar();
        return r.parseStr();
    }

    /** `has_next_element` of serde_json's `SeqAccess` */
    static function hasNextElement(r:SerdeReader, first:glaze.util.Ref<Bool>):Bool {
        final peek = r.parseWhitespace();
        if (peek == -1) {
            throw r.peekError(SerdeReader.EOF_WHILE_PARSING_LIST);
        }
        if (peek == ']'.code) {
            return false;
        }
        else if (first.value) {
            first.value = false;
            return true;
        }
        else if (peek == ','.code) {
            r.eatChar();
            switch r.parseWhitespace() {
                case ']'.code: throw r.peekError(SerdeReader.TRAILING_COMMA);
                case -1: throw r.peekError(SerdeReader.EOF_WHILE_PARSING_VALUE);
                case _: return true;
            }
        }
        else {
            throw r.peekError(SerdeReader.EXPECTED_LIST_COMMA_OR_END);
        }
    }

    /**
     * A derived struct (`deserialize_struct`): from a map (unknown keys
     * skipped, or errors when `denyUnknown`; duplicates and missing required
     * fields are errors) or from a sequence of the fields in order.
     * `onField` deserializes the value of the field it is given.
     */
    static function deStruct(r:SerdeReader, expecting:String, fields:Array<String>, defaults:Array<String>, required:Array<String>, onField:(String) -> Void, denyUnknown:Bool = false):Void {
        final peek = r.parseWhitespace();
        if (peek == -1) {
            throw r.peekError(SerdeReader.EOF_WHILE_PARSING_VALUE);
        }
        var err:Null<SerdeError> = null;
        if (peek == '['.code) {
            r.eatChar();
            try {
                final first = new glaze.util.Ref(true);
                for (i in 0...fields.length) {
                    if (hasNextElement(r, first)) {
                        onField(fields[i]);
                    }
                    else if (defaults.indexOf(fields[i]) < 0) {
                        throw SerdeError.invalidLength(i, '$expecting with ${fields.length} elements');
                    }
                }
            }
            catch (e:SerdeError) {
                err = e;
            }
            try {
                r.endSeq();
            }
            catch (e:SerdeError) {
                if (err == null) err = e;
            }
        }
        else if (peek == '{'.code) {
            r.eatChar();
            try {
                final seen:Array<String> = [];
                final first = new glaze.util.Ref(true);
                while (true) {
                    final key = nextKey(r, first);
                    if (key == null) break;
                    if (fields.indexOf(key) < 0) {
                        if (denyUnknown) {
                            throw SerdeError.unknownField(key, fields);
                        }
                        r.parseObjectColon();
                        r.ignoreValue();
                        continue;
                    }
                    if (seen.indexOf(key) >= 0) {
                        throw SerdeError.duplicateField(key);
                    }
                    r.parseObjectColon();
                    onField(key);
                    seen.push(key);
                }
                for (field in fields) {
                    if (seen.indexOf(field) < 0 && required.indexOf(field) >= 0) {
                        throw SerdeError.missingField(field);
                    }
                }
            }
            catch (e:SerdeError) {
                err = e;
            }
            try {
                r.endMap();
            }
            catch (e:SerdeError) {
                if (err == null) err = e;
            }
        }
        else {
            err = r.peekInvalidType(expecting);
        }
        if (err != null) {
            throw r.fixPosition(err);
        }
    }

    /** `Option<T>`: `null` leaves the field unset, anything else is read by `some`. */
    static function option(r:SerdeReader, some:() -> Void):Void {
        if (r.parseWhitespace() == 'n'.code) {
            r.eatChar();
            r.parseIdent('ull');
            return;
        }
        some();
    }

    /** `Vec<T>` */
    static function deSeq<T>(r:SerdeReader, element:() -> T):Array<T> {
        final peek = r.parseWhitespace();
        if (peek == -1) {
            throw r.peekError(SerdeReader.EOF_WHILE_PARSING_VALUE);
        }
        if (peek != '['.code) {
            throw r.peekInvalidType('a sequence');
        }
        r.eatChar();
        final result:Array<T> = [];
        var err:Null<SerdeError> = null;
        try {
            final first = new glaze.util.Ref(true);
            while (hasNextElement(r, first)) {
                result.push(element());
            }
        }
        catch (e:SerdeError) {
            err = e;
        }
        try {
            r.endSeq();
        }
        catch (e:SerdeError) {
            if (err == null) err = e;
        }
        if (err != null) throw r.fixPosition(err);
        return result;
    }

    /** `[T; 2]` */
    static function deArray2<T>(r:SerdeReader, element:() -> T):Array<T> {
        final peek = r.parseWhitespace();
        if (peek == -1) {
            throw r.peekError(SerdeReader.EOF_WHILE_PARSING_VALUE);
        }
        if (peek != '['.code) {
            throw r.peekInvalidType('an array of length 2');
        }
        r.eatChar();
        final result:Array<T> = [];
        var err:Null<SerdeError> = null;
        try {
            final first = new glaze.util.Ref(true);
            for (i in 0...2) {
                if (!hasNextElement(r, first)) {
                    throw SerdeError.invalidLength(i, 'an array of length 2');
                }
                result.push(element());
            }
        }
        catch (e:SerdeError) {
            err = e;
        }
        try {
            r.endSeq();
        }
        catch (e:SerdeError) {
            if (err == null) err = e;
        }
        if (err != null) throw r.fixPosition(err);
        return result;
    }

    /** An enum of unit variants (`deserialize_enum`): the index of the variant. */
    static function unitEnum(r:SerdeReader, variants:Array<String>):Int {
        return deEnum(r, variants, (variant, _) -> variants.indexOf(variant), variants);
    }

    /**
     * `deserialize_enum`: `"Variant"` or `{"Variant": value}`. `make` builds
     * the value of a variant, calling `newtype` to read the content of a
     * newtype variant. `units` are the unit variants.
     */
    static function deEnum<T>(r:SerdeReader, variants:Array<String>, make:(String, (() -> Dynamic) -> Dynamic) -> T, units:Array<String>):T {
        switch r.parseWhitespace() {
            case '{'.code:
                r.eatChar();
                switch r.parseWhitespace() {
                    case '"'.code:
                    case '}'.code: throw r.peekError(SerdeReader.EXPECTED_SOME_VALUE);
                    case -1: throw r.peekError(SerdeReader.EOF_WHILE_PARSING_OBJECT);
                    case _: throw r.peekError(SerdeReader.KEY_MUST_BE_A_STRING);
                }
                r.eatChar();
                final variant = r.parseStr();
                if (variants.indexOf(variant) < 0) {
                    throw r.fixPosition(SerdeError.unknownVariant(variant, variants));
                }
                r.parseObjectColon();
                final value = if (units.indexOf(variant) >= 0) {
                    deUnit(r);
                    make(variant, (_) -> throw 'unit variant');
                }
                else {
                    make(variant, (read) -> read());
                }
                switch r.parseWhitespace() {
                    case '}'.code:
                        r.eatChar();
                        return value;
                    case -1:
                        throw r.error(SerdeReader.EOF_WHILE_PARSING_OBJECT);
                    case _:
                        throw r.error(SerdeReader.EXPECTED_SOME_VALUE);
                }
            case '"'.code:
                r.eatChar();
                final variant = try r.parseStr() catch (e:SerdeError) throw r.fixPosition(e);
                if (variants.indexOf(variant) < 0) {
                    throw r.fixPosition(SerdeError.unknownVariant(variant, variants));
                }
                if (units.indexOf(variant) < 0) {
                    throw SerdeError.invalidType(Unexpected.UNIT_VARIANT, 'newtype variant');
                }
                return make(variant, (_) -> throw 'unit variant');
            case -1:
                throw r.peekError(SerdeReader.EOF_WHILE_PARSING_VALUE);
            case _:
                throw r.peekError(SerdeReader.EXPECTED_SOME_VALUE);
        }
    }

    /** `()` (the content of a unit variant written as a map) */
    static function deUnit(r:SerdeReader):Void {
        final peek = r.parseWhitespace();
        if (peek == -1) {
            throw r.peekError(SerdeReader.EOF_WHILE_PARSING_VALUE);
        }
        if (peek == 'n'.code) {
            r.eatChar();
            r.parseIdent('ull');
            return;
        }
        throw r.peekInvalidType('unit');
    }

    static function deBool(r:SerdeReader):Bool {
        switch r.parseWhitespace() {
            case 't'.code:
                r.eatChar();
                r.parseIdent('rue');
                return true;
            case 'f'.code:
                r.eatChar();
                r.parseIdent('alse');
                return false;
            case -1:
                throw r.peekError(SerdeReader.EOF_WHILE_PARSING_VALUE);
            case _:
                throw r.peekInvalidType('a boolean');
        }
    }

    /** `deserialize_str` with a visitor: the string, or the error of another type. */
    static function deStr(r:SerdeReader, expecting:String):String {
        switch r.parseWhitespace() {
            case '"'.code:
                r.eatChar();
                return r.parseStr();
            case -1:
                throw r.peekError(SerdeReader.EOF_WHILE_PARSING_VALUE);
            case _:
                throw r.peekInvalidType(expecting);
        }
    }

    static function deString(r:SerdeReader):String {
        return deStr(r, 'a string');
    }

    /** `f32` (and the `Pixels` and `FontWeight` newtypes) */
    static function deF32(r:SerdeReader):Float {
        final number = try r.parseNumberValue('f32') catch (e:SerdeError) throw r.fixPosition(e);
        return switch number {
            case F64(v) | U64(v) | I64(v): f32(v);
        }
    }

    /** An unsigned integer primitive (`u16`, `u32`, `usize`) */
    static function deUnsigned(r:SerdeReader, name:String, max:Float):Int {
        final number = try r.parseNumberValue(name) catch (e:SerdeError) throw r.fixPosition(e);
        return switch number {
            case U64(v):
                if (v > max) throw r.fixPosition(SerdeError.invalidValue(Unexpected.unsigned(v), name));
                Std.int(v);
            case I64(v):
                throw r.fixPosition(SerdeError.invalidValue(Unexpected.signed(v), name));
            case F64(v):
                throw r.fixPosition(SerdeError.invalidType(Unexpected.float(v), name));
        }
    }

    /** A signed integer primitive (`i16`) */
    static function deSigned(r:SerdeReader, name:String, min:Float, max:Float):Int {
        final number = try r.parseNumberValue(name) catch (e:SerdeError) throw r.fixPosition(e);
        return switch number {
            case U64(v):
                if (v > max) throw r.fixPosition(SerdeError.invalidValue(Unexpected.unsigned(v), name));
                Std.int(v);
            case I64(v):
                if (v < min) throw r.fixPosition(SerdeError.invalidValue(Unexpected.signed(v), name));
                Std.int(v);
            case F64(v):
                throw r.fixPosition(SerdeError.invalidType(Unexpected.float(v), name));
        }
    }

/// Lengths and colors from strings (`TryFrom<&str>`)

    static final EXPECTED_ABSOLUTE_LENGTH = "number with 'px' or 'rem' suffix";
    static final EXPECTED_DEFINITE_LENGTH = "expected number with 'px', 'rem', or '%' suffix";
    static final EXPECTED_LENGTH = "expected 'auto' or number with 'px', 'rem', or '%' suffix";
    static final EXPECTED_RGBA = 'a string in the format #rrggbb or #rrggbbaa';

    static function custom<T>(r:SerdeReader, f:() -> T):T {
        try {
            return f();
        }
        catch (e:String) {
            throw r.fixPosition(SerdeError.custom(e));
        }
    }

    static function deAbsolute(r:SerdeReader):AbsoluteLength {
        final value = deStr(r, EXPECTED_ABSOLUTE_LENGTH);
        return custom(r, () -> parseAbsolute(value));
    }

    static function deDefinite(r:SerdeReader):DefiniteLength {
        final value = deStr(r, EXPECTED_DEFINITE_LENGTH);
        return custom(r, () -> parseDefinite(value));
    }

    static function deLength(r:SerdeReader):Length {
        final value = deStr(r, EXPECTED_LENGTH);
        return custom(r, () -> parseLength(value));
    }

    static function deHsla(r:SerdeReader):Hsla {
        final value = deStr(r, EXPECTED_RGBA);
        return custom(r, () -> parseHsla(value));
    }

    static function withSuffix(value:String, suffix:String):Null<Float> {
        if (!StringTools.endsWith(value, suffix)) return null;
        return parseRustF32(value.substr(0, value.length - suffix.length));
    }

    /** `TryFrom<&str> for AbsoluteLength` (throws the message) */
    public static function parseAbsolute(value:String):AbsoluteLength {
        final pixels = withSuffix(value, 'px');
        if (pixels != null) return AbsoluteLength.Pixels(pixels);
        final rems = withSuffix(value, 'rem');
        if (rems != null) return AbsoluteLength.Rems(rems);
        throw 'invalid AbsoluteLength \'$value\', expected $EXPECTED_ABSOLUTE_LENGTH';
    }

    /** `TryFrom<&str> for DefiniteLength` */
    public static function parseDefinite(value:String):DefiniteLength {
        if (StringTools.endsWith(value, '%')) {
            final percentage = parseRustF32(value.substr(0, value.length - 1));
            if (percentage == null) {
                throw 'invalid DefiniteLength \'$value\', expected $EXPECTED_DEFINITE_LENGTH';
            }
            return DefiniteLength.Fraction(f32(percentage / 100.0));
        }
        try {
            return DefiniteLength.Absolute(parseAbsolute(value));
        }
        catch (e:String) {
            throw 'invalid DefiniteLength \'$value\', expected $EXPECTED_DEFINITE_LENGTH';
        }
    }

    /** `TryFrom<&str> for Length` */
    public static function parseLength(value:String):Length {
        if (value == 'auto') return Length.Auto;
        try {
            return Length.Definite(parseDefinite(value));
        }
        catch (e:String) {
            throw 'invalid Length \'$value\', expected $EXPECTED_LENGTH';
        }
    }

    /**
     * Rust `str::parse::<f32>`: `[+-]` then `inf`, `infinity`, `nan` (any
     * case) or digits with an optional fraction and exponent; `null` when
     * invalid.
     */
    public static function parseRustF32(text:String):Null<Float> {
        var i = 0;
        var negative = false;
        if (text.length > 0 && (text.charAt(0) == '+' || text.charAt(0) == '-')) {
            negative = text.charAt(0) == '-';
            i = 1;
        }
        final rest = text.substr(i).toLowerCase();
        if (rest == 'inf' || rest == 'infinity') return negative ? Math.NEGATIVE_INFINITY : Math.POSITIVE_INFINITY;
        if (rest == 'nan') return Math.NaN;
        final number = ~/^([0-9]+\.?[0-9]*|\.[0-9]+)([eE][+-]?[0-9]+)?$/;
        if (!number.match(rest)) return null;
        final value = f32(Std.parseFloat(rest));
        return negative ? -value : value;
    }

    /** `u8::from_str_radix(text, 16)`, throwing `ParseIntError`'s message */
    static function hexU8(text:String):Int {
        if (text.length == 0) throw 'cannot parse integer from empty string';
        var digits = text;
        if (digits.charAt(0) == '+' && digits.length > 1) digits = digits.substr(1);
        var value = 0;
        for (i in 0...digits.length) {
            final c = digits.charCodeAt(i);
            final d = if (c >= '0'.code && c <= '9'.code) c - '0'.code else if (c >= 'a'.code && c <= 'f'.code) c - 'a'.code + 10 else if (c >= 'A'.code && c <= 'F'.code) c - 'A'.code + 10 else -1;
            if (d < 0) throw 'invalid digit found in string';
            value = value * 16 + d;
            if (value > 255) throw 'number too large to fit in target type';
        }
        return value;
    }

    /** Rust `str::get(start..end)` on UTF-8 bytes: `null` off a char boundary */
    static function byteSlice(bytes:haxe.io.Bytes, start:Int, end:Int):Null<String> {
        inline function boundary(i:Int):Bool {
            return i == 0 || i == bytes.length || (bytes.get(i) & 0xC0) != 0x80;
        }
        if (!boundary(start) || !boundary(end)) return null;
        return bytes.getString(start, end - start);
    }

    /** `TryFrom<&str> for Rgba`, then `From<Rgba> for Hsla` (throws the message) */
    public static function parseHsla(value:String):Hsla {
        final expectedFormats = 'Expected #rgb, #rgba, #rrggbb, or #rrggbbaa';
        final invalidUnicode = 'invalid unicode characters in color';
        final trimmed = rustTrim(value);
        if (!StringTools.startsWith(trimmed, '#')) {
            throw 'invalid RGBA hex color: \'$value\'. $expectedFormats';
        }
        final hex = haxe.io.Bytes.ofString(trimmed.substr(1));
        final component = (start:Int, end:Int, what:String) -> {
            final s = byteSlice(hex, start, end);
            if (s == null) throw '$invalidUnicode: $what for value: \'$value\'';
            return hexU8(s);
        };
        var r:Int, g:Int, b:Int, a:Int;
        switch hex.length {
            case 3 | 4:
                r = component(0, 1, 'r component of #rgb/#rgba');
                g = component(1, 2, 'g component of #rgb/#rgba');
                b = component(2, 3, 'b component of #rgb/#rgba');
                a = hex.length == 4 ? component(3, 4, 'a component of #rgba') : 0xf;
                r = (r << 4) | r;
                g = (g << 4) | g;
                b = (b << 4) | b;
                a = (a << 4) | a;
            case 6 | 8:
                r = component(0, 2, 'r component of #rrggbb/#rrggbbaa');
                g = component(2, 4, 'g component of #rrggbb/#rrggbbaa');
                b = component(4, 6, 'b component of #rrggbb/#rrggbbaa');
                a = hex.length == 8 ? component(6, 8, 'a component of #rrggbbaa') : 0xff;
            case _:
                throw 'invalid RGBA hex color: \'$value\'. $expectedFormats';
        }
        return rgbaToHsla(f32(r / 255), f32(g / 255), f32(b / 255), f32(a / 255));
    }

    /** Rust `str::trim` (Unicode white space) */
    static function rustTrim(value:String):String {
        inline function isSpace(c:Int):Bool {
            return c == 0x20 || (c >= 0x09 && c <= 0x0d) || c == 0x85 || c == 0xa0 || c == 0x1680 || (c >= 0x2000 && c <= 0x200a)
                || c == 0x2028 || c == 0x2029 || c == 0x202f || c == 0x205f || c == 0x3000;
        }
        var start = 0;
        var end = value.length;
        while (start < end && isSpace(value.charCodeAt(start))) start++;
        while (end > start && isSpace(value.charCodeAt(end - 1))) end--;
        return value.substring(start, end);
    }

}
