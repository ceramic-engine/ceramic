package gpui;

/**
 * Runtime helpers of the code generated by `ActionMacro`: reading action
 * fields from a JSON value (Rust: `serde_json::from_value`) and comparing
 * field values (Rust: derived `PartialEq`). Not used in hot paths.
 */
class ActionJson {

    /**
     * Checks that `value` is a JSON object (serde: a struct is a map).
     */
    public static function object(value:Dynamic, typeName:String):Dynamic {
        if (value == null || !Reflect.isObject(value) || Std.isOfType(value, String) || Std.isOfType(value, Array)) {
            throw new haxe.Exception('invalid type: ' + describe(value) + ', expected struct $typeName');
        }
        return value;
    }

    static function read(object:Dynamic, name:String, optional:Bool):Dynamic {
        if (!Reflect.hasField(object, name)) {
            if (optional) return null;
            throw new haxe.Exception('missing field `$name`');
        }
        final value:Dynamic = Reflect.field(object, name);
        if (value == null && !optional) {
            throw new haxe.Exception('invalid type: null, expected field `$name`');
        }
        return value;
    }

    public static function readBool(object:Dynamic, name:String, optional:Bool):Null<Bool> {
        final value:Dynamic = read(object, name, optional);
        if (value != null && !Std.isOfType(value, Bool)) {
            throw new haxe.Exception('invalid type: ' + describe(value) + ', expected a boolean');
        }
        return value;
    }

    public static function readInt(object:Dynamic, name:String, optional:Bool):Null<Int> {
        final value:Dynamic = read(object, name, optional);
        if (value == null) return null;
        if (Std.isOfType(value, Int)) return value;
        if (Std.isOfType(value, Float)) {
            final f:Float = value;
            if (Math.ffloor(f) == f && Math.abs(f) < 2147483648.0) return Std.int(f);
        }
        throw new haxe.Exception('invalid type: ' + describe(value) + ', expected an integer');
    }

    public static function readFloat(object:Dynamic, name:String, optional:Bool):Null<Float> {
        final value:Dynamic = read(object, name, optional);
        if (value != null && !Std.isOfType(value, Float) && !Std.isOfType(value, Int)) {
            throw new haxe.Exception('invalid type: ' + describe(value) + ', expected a number');
        }
        return value;
    }

    public static function readString(object:Dynamic, name:String, optional:Bool):Null<String> {
        final value:Dynamic = read(object, name, optional);
        if (value != null && !Std.isOfType(value, String)) {
            throw new haxe.Exception('invalid type: ' + describe(value) + ', expected a string');
        }
        return value;
    }

    /**
     * Fields of other types are passed through unchecked.
     */
    public static function readAny(object:Dynamic, name:String, optional:Bool):Dynamic {
        return read(object, name, optional);
    }

    static function describe(value:Dynamic):String {
        if (value == null) return 'null';
        if (Std.isOfType(value, Bool)) return 'boolean `$value`';
        if (Std.isOfType(value, Int) || Std.isOfType(value, Float)) return 'number `$value`';
        if (Std.isOfType(value, String)) return 'string "$value"';
        if (Std.isOfType(value, Array)) return 'sequence';
        return 'map';
    }

    /**
     * Deep equality of two field values: primitives, arrays, enums, anonymous
     * structures, actions (`partialEq`) and objects with an `equals` method.
     */
    public static function valueEquals(a:Dynamic, b:Dynamic):Bool {
        if (a == b) return true;
        if (a == null || b == null) return false;
        if (Std.isOfType(a, Array) && Std.isOfType(b, Array)) {
            final aa:Array<Dynamic> = a;
            final bb:Array<Dynamic> = b;
            if (aa.length != bb.length) return false;
            for (i in 0...aa.length) {
                if (!valueEquals(aa[i], bb[i])) return false;
            }
            return true;
        }
        if (Reflect.isEnumValue(a) && Reflect.isEnumValue(b)) {
            if (Type.getEnum(a) != Type.getEnum(b) || Type.enumIndex(a) != Type.enumIndex(b)) return false;
            final pa = Type.enumParameters(a);
            final pb = Type.enumParameters(b);
            if (pa.length != pb.length) return false;
            for (i in 0...pa.length) {
                if (!valueEquals(pa[i], pb[i])) return false;
            }
            return true;
        }
        if (Std.isOfType(a, Action) && Std.isOfType(b, Action)) {
            return (a : Action).partialEq(b);
        }
        final aClass = Type.getClass(a);
        if (aClass != null) {
            if (aClass != Type.getClass(b)) return false;
            final equals = Reflect.field(a, 'equals');
            if (equals != null && Reflect.isFunction(equals)) {
                return Reflect.callMethod(a, equals, [b]);
            }
            return false;
        }
        if (Reflect.isObject(a) && Reflect.isObject(b) && Type.getClass(b) == null) {
            final fields = Reflect.fields(a);
            if (fields.length != Reflect.fields(b).length) return false;
            for (field in fields) {
                if (!Reflect.hasField(b, field)) return false;
                if (!valueEquals(Reflect.field(a, field), Reflect.field(b, field))) return false;
            }
            return true;
        }
        return false;
    }

}
