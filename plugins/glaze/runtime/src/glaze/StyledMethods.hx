package glaze;

/**
 * The fluent style methods of every `Styled` element (`flex()`, `gap2()`,
 * `roundedMd()`, `bg(...)`...), generated by `StyledMacro.buildMethods()`
 * as `extern inline` static extensions and attached to `Styled` with
 * `@:using`, so no `using` is needed to call them.
 *
 * Code taking a type parameter `T:Styled` adds
 * `using glaze.StyledMethods;` to call them on `T`.
 */
@:build(glaze.StyledMacro.buildMethods())
class StyledMethods {}
