package glaze;

/**
 * A click event, generated when a mouse button or keyboard button is pressed
 * and released, or when a tap gesture is recognized on a touch screen.
 */
@:using(glaze.ClickEvent.ClickEventTools)
enum ClickEvent {

    /** A click event triggered by a mouse button being pressed and released. */
    Mouse(event:MouseClickEvent);

    /** A click event triggered by a keyboard button being pressed and released. */
    Keyboard(event:KeyboardClickEvent);

    /** A click event triggered by a recognized tap gesture on a touch screen. */
    Touch(event:TouchClickEvent);

}

/**
 * A click event that was generated by a recognized tap gesture on a touch
 * screen.
 */
class TouchClickEvent {

    /** The position of the tap in window coordinates. */
    public final position:Point;

    /**
     * The number of consecutive taps at this location (double tap = 2),
     * analogous to the mouse `clickCount`.
     */
    public final tapCount:Int;

    /**
     * Whether this was a long press rather than a tap. Long presses are
     * touch's secondary activation: they are delivered to aux-click
     * listeners alongside right clicks, not to primary click listeners.
     */
    public final longPress:Bool;

    public function new(position:Point, tapCount:Int = 0, longPress:Bool = false) {
        this.position = position;
        this.tapCount = tapCount;
        this.longPress = longPress;
    }

}

/**
 * A click event triggered by a mouse button being pressed and released.
 */
class MouseClickEvent {

    /** The mouse event when the button was pressed. */
    public final down:MouseDownEvent;

    /** The mouse event when the button was released. */
    public final up:MouseUpEvent;

    public function new(down:MouseDownEvent, up:MouseUpEvent) {
        this.down = down;
        this.up = up;
    }

}

/**
 * A click event triggered by a keyboard button being pressed and released.
 */
class KeyboardClickEvent {

    /** The keyboard button that was pressed to trigger the click. */
    public final button:KeyboardButton;

    /** The bounds of the element that was clicked. */
    public final bounds:Bounds;

    public function new(button:KeyboardButton, bounds:Bounds) {
        this.button = button;
        this.bounds = bounds;
    }

}

class ClickEventTools {

    /**
     * Returns the modifiers that were held during the click event.
     * Keyboard clicks are only generated without modifiers.
     */
    public static function modifiers(event:ClickEvent):Modifiers {
        return switch event {
            case Keyboard(_): Modifiers.none();
            case Mouse(e): e.up.modifiers;
            // Touch screens have no modifier keys.
            case Touch(_): Modifiers.none();
        }
    }

    /**
     * Returns the position of the click event (bottom left of the bounds for keyboard clicks).
     */
    public static function position(event:ClickEvent):Point {
        return switch event {
            case Keyboard(e): e.bounds.bottomLeft();
            case Mouse(e): e.up.position;
            case Touch(e): e.position;
        }
    }

    /**
     * Returns the mouse position of the click event, if it was a mouse click.
     */
    public static function mousePosition(event:ClickEvent):Null<Point> {
        return switch event {
            case Keyboard(_): null;
            case Mouse(e): e.up.position;
            // Touches are not mouse input and there is no cursor.
            case Touch(_): null;
        }
    }

    /**
     * Returns if this was a right click.
     */
    public static function isRightClick(event:ClickEvent):Bool {
        return switch event {
            case Keyboard(_): false;
            case Mouse(e): e.down.button == Right && e.up.button == Right;
            case Touch(_): false;
        }
    }

    /**
     * Returns if this was a middle click.
     */
    public static function isMiddleClick(event:ClickEvent):Bool {
        return switch event {
            case Keyboard(_): false;
            case Mouse(e): e.down.button == Middle && e.up.button == Middle;
            case Touch(_): false;
        }
    }

    /**
     * Returns whether the click is a secondary activation, i.e. a context
     * menu trigger: a right click from a mouse, or a long press on a touch
     * screen.
     */
    public static function isSecondary(event:ClickEvent):Bool {
        return switch event {
            case Keyboard(_): false;
            case Mouse(e): e.down.button == Right && e.up.button == Right;
            case Touch(e): e.longPress;
        }
    }

    /**
     * Returns if this was a standard click (left mouse button or a keyboard click).
     */
    public static function standardClick(event:ClickEvent):Bool {
        return switch event {
            case Keyboard(_): true;
            case Mouse(e): e.down.button == Left && e.up.button == Left;
            case Touch(e): !e.longPress;
        }
    }

    /**
     * Returns whether the click focused the element's window.
     */
    public static function firstFocus(event:ClickEvent):Bool {
        return switch event {
            case Keyboard(_): false;
            case Mouse(e): e.down.firstMouse;
            // Mobile windows are already active when tappable.
            case Touch(_): false;
        }
    }

    /**
     * Returns the click count of the click event (1 for keyboard clicks).
     */
    public static function clickCount(event:ClickEvent):Int {
        return switch event {
            case Keyboard(_): 1;
            case Mouse(e): e.up.clickCount;
            case Touch(e): e.tapCount;
        }
    }

    /**
     * Returns whether the click event is generated by a keyboard event.
     */
    public static function isKeyboard(event:ClickEvent):Bool {
        return switch event {
            case Keyboard(_): true;
            case Mouse(_) | Touch(_): false;
        }
    }

}
