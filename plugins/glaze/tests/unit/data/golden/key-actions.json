{
  "behaviour": "key-actions",
  "description": "Key bindings with contexts, multi-stroke bindings and pending timeout, action capture / bubble, propagate, key down / up",
  "log": [
    "> focus editor",
    "focused=editor pending=none",
    "> key a",
    "Workspace capture_action ActionA",
    "Editor on_action ActionA",
    "focused=editor pending=none",
    "> key_up a",
    "Editor on_key_up a",
    "Workspace on_key_up a",
    "focused=editor pending=none",
    "> key b",
    "Workspace capture_action ActionB",
    "Pane on_action ActionB propagate",
    "Workspace on_action ActionB",
    "focused=editor pending=none",
    "> key x",
    "Workspace capture_key_down x",
    "Pane capture_key_down x",
    "Editor on_key_down x",
    "Workspace on_key_down x",
    "focused=editor pending=none",
    "> key_up x",
    "Editor on_key_up x",
    "Workspace on_key_up x",
    "focused=editor pending=none",
    "> key ctrl-k",
    "focused=editor pending=ctrl-k",
    "> key ctrl-c",
    "Editor on_action Multi",
    "focused=editor pending=none",
    "> key ctrl-k",
    "focused=editor pending=ctrl-k",
    "> advance 500ms",
    "focused=editor pending=ctrl-k",
    "> advance 600ms",
    "Workspace capture_action ActionB",
    "Pane on_action ActionB propagate",
    "Workspace on_action ActionB",
    "focused=editor pending=none",
    "> key escape",
    "Workspace capture_action Escape",
    "Workspace on_action Escape",
    "focused=editor pending=none",
    "> dispatch_action ActionA",
    "Workspace capture_action ActionA",
    "Editor on_action ActionA",
    "focused=editor pending=none",
    "> focus ws",
    "focused=ws pending=none",
    "> key a",
    "Workspace capture_key_down a",
    "Workspace on_key_down a",
    "focused=ws pending=none"
  ]
}
