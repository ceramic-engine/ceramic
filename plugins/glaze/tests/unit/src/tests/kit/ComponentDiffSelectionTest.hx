package tests.kit;

import gpui.Bounds;
import gpui.HighlightStyle;
import gpui.Hsla;
import gpui.Point;
import gpui.Range;
import gpui.Size;
import gpui.component.diff.Diff;
import gpui.component.diff.DiffDecoration;
import gpui.component.diff.DiffFile;
import gpui.component.diff.DiffLinePosition;
import gpui.component.diff.DiffLineRange;
import gpui.component.diff.DiffSide;
import gpui.component.diff.Presentation.DiffStyledRange;
import gpui.component.diff.Selection;
import gpui.util.Utf8;
import testing.TestCase;
import tests.kit.ComponentDiffFixture as Fixture;

import gpui.Prelude.*;

/**
 * The selection, copy, line ending and decoration unit tests of gpui-kit's diff.
 */
class ComponentDiffSelectionTest extends TestCase {

    static function style(?color:Hsla, ?background:Hsla, ?fadeOut:Float):HighlightStyle {
        final s = new HighlightStyle();
        s.color = color;
        s.backgroundColor = background;
        s.fadeOut = fadeOut;
        return s;
    }

    static function hslaEq(a:Null<Hsla>, b:Null<Hsla>):Bool {
        return a == null ? b == null : (b != null && a.equals(b));
    }

    // selection_tests.rs

    function testSourceSelectionMapsExpandedTabsAndMultibyteTextWithoutLosingLineEndings() {
        final source = '\tα\tx\r\nnext\n';
        final document = Fixture.document(null, ['text', source]);
        final first = document.lines(Modified)[0];
        assertEquals('    α   x', first.display());
        // Every painted space generated by a tab maps back to that single byte.
        for (ix in 0...4)
            assertEquals(0, first.sourceOffset(ix));
        for (ix in 6...9)
            assertEquals(3, first.sourceOffset(ix));
        assertEquals('4..6', first.displayRange(new Range(1, 3)).toString());
        assertEquals('6..9', first.displayRange(new Range(3, 4)).toString());
        assertEquals(first.textLen(), first.sourceOffset(first.displayLen()));
        final next = document.lines(Modified)[1];
        final anchor = first.source().start + first.sourceOffset(4);
        final cursor = next.source().start + next.sourceOffset(2);
        assertEquals('α\tx\r\nne', Utf8.substring(document.source(Modified), anchor, cursor));
    }

    function testOverlappingInlineAndSelectionHighlightsPreserveSyntaxAndPrecedence() {
        final syntaxColor:Hsla = rgb(0x336699).toHsla();
        final inlineColor:Hsla = rgb(0x884422).toHsla();
        final selectionColor:Hsla = rgb(0x225588).toHsla();
        final highlights = @:privateAccess Selection.mergeHighlights(8, [
            new DiffStyledRange(new Range(0, 8), style(syntaxColor)),
            new DiffStyledRange(new Range(2, 7), style(null, inlineColor)),
            new DiffStyledRange(new Range(4, 6), style(null, selectionColor)),
        ]);
        assertEquals('0..2,2..4,4..6,6..7,7..8', [for (h in highlights) h.range.toString()].join(','));
        assertTrue(Lambda.foreach(highlights, h -> hslaEq(syntaxColor, h.style.color)));
        final backgrounds:Array<Null<Hsla>> = [null, inlineColor, selectionColor, inlineColor, null];
        for (i in 0...backgrounds.length)
            assertTrue(hslaEq(backgrounds[i], highlights[i].style.backgroundColor), 'background $i');
        assertEquals(0, @:privateAccess Selection.mergeHighlights(0, []).length);
    }

    function testMultiClickLineTopPrefersCurrentLineOverPreviousBottom() {
        final previous = new Bounds(new Point(20., 30.), new Size(100., 20.));
        final current = new Bounds(new Point(20., 50.), new Size(100., 20.));
        function less(point:Point):Bool {
            return @:privateAccess Selection.compareLineDistance(Selection.lineDistance(point, current), Selection.lineDistance(point, previous)) < 0;
        }
        assertTrue(less(new Point(40., 50.)));
        // Horizontal dragging beyond the text keeps the same source line.
        assertTrue(less(new Point(400., 50.)));
    }

    function testHighlightSweepRestoresLowerPrecedenceAfterEdgesAndClampsInvalidRanges() {
        final merged = @:privateAccess Selection.mergeHighlights(10, [
            new DiffStyledRange(new Range(0, 12), style(null, null, 0.2)),
            new DiffStyledRange(new Range(4, 8), style(null, null, 0.7)),
            new DiffStyledRange(new Range(2, 6), style(null, null, 0.9)),
            new DiffStyledRange(new Range(7, 7), style(null, null, 1.)),
            new DiffStyledRange(new Range(11, 15), style(null, null, 1.)),
        ]);
        assertEquals('0..2:0.2,2..4:0.9,4..6:0.9,6..8:0.7,8..10:0.2', [for (m in merged) m.range.toString() + ':' + m.style.fadeOut].join(','));
    }

    function testHighlightChunksClipAndRebaseWithoutDuplicatingAdjacentBoundaries() {
        function clip(a:Int, b:Int):String {
            final r = @:privateAccess Selection.clipHighlight(new Range(a, b), new Range(8, 16));
            return r == null ? 'none' : r.toString();
        }
        assertEquals('0..4', clip(4, 12));
        assertEquals('4..8', clip(12, 20));
        assertEquals('0..8', clip(8, 16));
        assertEquals('none', clip(4, 8));
        assertEquals('none', clip(16, 20));
    }

    function testNativeWordSelectionCrossesRenderChunksAndRespectsUnicodeAndFlankBounds() {
        function word(text:String, offset:Int):String {
            final r = @:privateAccess Selection.wordRange(text, offset);
            return r == null ? 'none' : r.toString();
        }
        final token = StringTools.lpad('', 'a', 1024);
        assertEquals('384..641', word(token, 512));
        assertEquals('2..9', word('  foo_bar  !', 4));
        assertEquals('9..11', word('  foo_bar  !', 9));
        assertEquals('11..12', word('  foo_bar  !', 11));
        final text = 'éяa\u{0301}界';
        assertEquals('0..7', word(text, 2));
        assertEquals('7..10', word(text, 7));
        assertEquals('none', word(text, Utf8.byteLength(text)));
    }

    // copy_tests.rs

    /** Copies a normalized range, as gutter and keyboard selection do. */
    static function copy(document:DiffFile, side:DiffSide, start:Int, end:Int):String {
        final range = new DiffLineRange('', side, start, end);
        final lo = range.start() < range.end() ? range.start() : range.end();
        final hi = range.start() > range.end() ? range.start() : range.end();
        return document.textForLines(side, lo, hi);
    }

    function testCopyingSourceLineRangesPreservesWhitespaceUnicodeAndEof() {
        final original = '\t旧值 🦀\r\n\r\n尾部\t  ';
        final modified = '\t新值 👩‍💻\r\n\r\n尾部\t  \r\n';
        final document = Fixture.modified('review.txt', original, modified);
        for (item in [
            {side: DiffSide.Original, source: original, first: '\t旧值 🦀\r\n', last: '尾部\t  '},
            {side: DiffSide.Modified, source: modified, first: '\t新值 👩‍💻\r\n', last: '尾部\t  \r\n'},
        ]) {
            // Reversed endpoints and a zero endpoint still copy complete source lines.
            assertEquals(item.source, copy(document, item.side, Fixture.MAX, 0));
            assertEquals(item.first, copy(document, item.side, 0, 0));
            assertEquals('\r\n', copy(document, item.side, 2, 2));
            assertEquals(item.last, copy(document, item.side, 3, Fixture.MAX));
            assertEquals('', copy(document, item.side, 4, Fixture.MAX));
        }
    }

    function testCopyingAddedDeletedAndEmptyFilesRespectsTheRequestedSide() {
        final source = '\t中文 🦀\r\n末行';
        for (item in [
            {document: Fixture.document(null, ['new.txt', source]), present: DiffSide.Modified, missing: DiffSide.Original},
            {document: Fixture.document(['old.txt', source], null), present: DiffSide.Original, missing: DiffSide.Modified},
        ]) {
            assertEquals(source, copy(item.document, item.present, 1, Fixture.MAX));
            assertEquals('', copy(item.document, item.missing, 1, Fixture.MAX));
            assertEquals('', copy(item.document, item.present, Fixture.MAX, Fixture.MAX));
        }
        final empty = Fixture.modified('empty.txt', '', '');
        for (side in [DiffSide.Original, DiffSide.Modified])
            assertEquals('', copy(empty, side, 0, Fixture.MAX));
    }

    // newline_tests.rs

    static function hasLineEndingChange(document:DiffFile, side:DiffSide, ix:Int, counterpart:Null<Int>):Bool {
        return @:privateAccess Diff.hasLineEndingChange(document, side, ix, counterpart);
    }

    function testEndingChangesRetainCounterpartsAndExactSource() {
        for (item in [
            {original: 'same\n', modified: 'same', endingOnly: true},
            {original: 'same\r\n', modified: 'same\n', endingOnly: true},
            {original: 'same', modified: 'same\r\n', endingOnly: true},
            {original: 'old\r\n', modified: 'new\n', endingOnly: false},
            {original: '\t\n', modified: '    \n', endingOnly: false},
        ]) {
            final document = Fixture.modified('a.txt', item.original, item.modified);
            assertTrue(document.hasChanges());
            for (side in [DiffSide.Original, DiffSide.Modified]) {
                final line = document.lines(side)[0];
                assertEquals(0, line.counterpart());
                assertEquals(item.endingOnly, hasLineEndingChange(document, side, 0, line.counterpart()));
                assertEquals(document.source(side), document.textForLines(side, 1, 1));
            }
        }
    }

    function testMissingFilesAndBlankLinesHaveNoFalseCounterparts() {
        for (document in [Fixture.document(null, ['empty.txt', '']), Fixture.document(['empty.txt', ''], null)]) {
            assertTrue(document.hasChanges());
            assertEquals(0, document.additions());
            assertEquals(0, document.deletions());
            assertEquals(0, document.linesCount(Original));
            assertEquals(0, document.linesCount(Modified));
        }
        for (item in [{original: '', modified: '\n', side: DiffSide.Modified}, {original: '\n', modified: '', side: DiffSide.Original}]) {
            final document = Fixture.modified('a.txt', item.original, item.modified);
            final line = document.lines(item.side)[0];
            assertEquals('', line.text());
            assertNull(line.counterpart());
            assertFalse(hasLineEndingChange(document, item.side, 0, line.counterpart()));
            assertEquals('\n', document.textForLines(item.side, 1, 1));
        }
    }

    // decoration_tests.rs

    function testDecorationsCoverTheirRangeAndTheLastSuppliedWins() {
        final red = Hsla.red();
        final blue = Hsla.blue();
        final decorations = @:privateAccess new gpui.component.diff.DiffDecoration.Decorations([
            new DiffDecoration(new DiffLineRange('file.txt', Modified, 2, 4)).withBackground(red),
            new DiffDecoration(new DiffLineRange('file.txt', Modified, 4, 4)).withBackground(blue),
            new DiffDecoration(new DiffLineRange('cross.txt', Original, 8, 3).withEndSide(Modified)),
        ]);
        function backgroundIn(path:String, side:DiffSide, line:Int):String {
            final decoration = @:privateAccess decorations.at(new DiffLinePosition(path, side, line));
            if (decoration == null)
                return 'none';
            final background = decoration.background();
            return background == null ? 'default' : (background.equals(red) ? 'red' : (background.equals(blue) ? 'blue' : 'other'));
        }
        function background(side:DiffSide, line:Int) {
            return backgroundIn('file.txt', side, line);
        }
        assertEquals('none', background(Modified, 1));
        assertEquals('red', background(Modified, 2));
        assertEquals('blue', background(Modified, 4));
        assertEquals('none', background(Modified, 5));
        // A cross-side range runs from its start onwards and up to its end.
        assertEquals('none', backgroundIn('cross.txt', Original, 7));
        assertEquals('default', backgroundIn('cross.txt', Original, 9));
        assertEquals('default', backgroundIn('cross.txt', Modified, 3));
        assertEquals('none', backgroundIn('cross.txt', Modified, 4));
        assertEquals('none', backgroundIn('other.txt', Modified, 2));
    }

}
