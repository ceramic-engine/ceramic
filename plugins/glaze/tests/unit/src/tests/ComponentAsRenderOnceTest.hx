package tests;

import glaze.AnyElement;
import glaze.AnyView;
import glaze.App;
import glaze.Component;
import glaze.Context;
import glaze.ElementId;
import glaze.Entity;
import glaze.Model;
import glaze.IntoElement;
import glaze.ParentElement;
import glaze.RenderOnce;
import glaze.TestDispatcher;
import glaze.ViewElement;
import glaze.Window;
import glaze.kit.input.InputGroup.InputGroupAddon;
import testing.TestCase;
import tests.ComponentTest.ParentView;
import tests.ComponentTest.Toggle;

import glaze.Prelude.*;

/**
 * A `glaze.Component` is a `RenderOnce`: accepted wherever a `RenderOnce`
 * is, rendered under the same element id path as a `RenderOnce` of the same
 * class (so keyed element states and scene dumps do not change when a kit
 * class becomes a component), with `component(...)` generated by
 * `ComponentMacro` only (type parameter constraints kept, a hand written
 * `component` kept, none for a non-public constructor).
 */
class ComponentAsRenderOnceTest extends TestCase {

    var dispatcher:TestDispatcher;

    var app:App;

    final windows:Array<Window> = [];

    override function setup() {
        dispatcher = new TestDispatcher();
        app = new App(dispatcher);
        Probes.reset();
        flushImmediate();
    }

    override function teardown() {
        for (window in windows) {
            window.destroy();
        }
        windows.resize(0);
        flushImmediate();
    }

    inline function flushImmediate():Void {
        ceramic.App.app.flushImmediate();
    }

    function openWindow(root:AnyView):Window {
        final window = Window.open(app, {width: 400, height: 400, scaleFactor: 2, autoDraw: false, bindInput: false, viewCaching: true}, (_, _) -> root);
        windows.push(window);
        return window;
    }

    function view(render:(Window, Context<Dynamic>) -> IntoElement):Entity<ParentView> {
        return app.newEntity((_:Context<ParentView>) -> new ParentView(render));
    }

    function frame():Void {
        flushImmediate();
        for (window in windows) {
            window.drawIfDirty();
        }
    }

    function testComponentIsARenderOnce() {
        final probe:RenderOnce = Probe.component();
        assertTrue(Std.isOfType(probe, RenderOnce));
        assertTrue(Std.isOfType(probe, Component));
        // An interface extending RenderOnce is satisfied by a component
        final item:ProbeItem = TaggedItem.component('a');
        assertEquals('a', (cast item : TaggedItem).tagProp);
    }

    function testElementIdPathIsTheOneOfARenderOnceOfTheSameClass() {
        // The same class rendered as a `RenderOnce` (`ViewElement.forComponent`,
        // what a `RenderOnce` class gets) and as a stateless component
        final toggle = app.newEntity(_ -> new Toggle());
        final parent = view((_, cx) -> div().id('root').child(toggle.read(cx).on
            ? (ViewElement.forComponent(Probe.component()).intoAnyElement() : IntoElement)
            : Probe.component()));
        openWindow(parent);
        frame();
        assertEquals(1, Probes.paths.length);
        final asRenderOnce = Probes.paths[0];
        final expected = Type.getClassName(Probe);
        assertTrue(asRenderOnce.length >= 2);
        assertTrue(Type.enumEq(ElementId.Name(expected), asRenderOnce[asRenderOnce.length - 1]), 'a RenderOnce renders under the name of its class');

        toggle.read(app).on = false;
        frame();
        assertEquals(2, Probes.paths.length);
        final asComponent = Probes.paths[1];
        assertEquals(pathString(asRenderOnce), pathString(asComponent), 'same element id path');

        // The keyed state made under the RenderOnce is found again by the component
        assertEquals('0,0', Probes.states.join(','));
        assertEquals(Probes.stateKeys[0], Probes.stateKeys[1]);
    }

    function testElementIdOfAPublicClassAndOfAModuleSubtype() {
        // The name a `RenderOnce` gets is `Type.getClassName` of its class
        final parent = view((_, _) -> div().child(PublicProbe.component()).child(ProbeHolder.component(new Measured(2))));
        openWindow(parent);
        frame();
        assertEquals(2, Probes.paths.length);
        final first = Probes.paths[0];
        assertTrue(Type.enumEq(ElementId.Name(Type.getClassName(PublicProbe)), first[first.length - 1]));
        final second = Probes.paths[1];
        assertTrue(Type.enumEq(ElementId.Name(Type.getClassName(ProbeHolder)), second[second.length - 1]));
    }

    function testComponentTypedRenderOnceKeepsItsKey() {
        // Placed through a value typed `RenderOnce`, the component keeps `.at(key)`
        final parent = view((_, _) -> {
            final item:RenderOnce = Probe.component().at('keyed');
            return div().child(item);
        });
        openWindow(parent);
        frame();
        final path = Probes.paths[0];
        assertTrue(Type.enumEq(ElementId.Name('keyed'), path[path.length - 1]));
    }

    function testPersistentComponentThroughARenderOnceValue() {
        final parent = view((_, _) -> {
            final item:RenderOnce = Persisted.component().label('a');
            return div().child(item);
        });
        openWindow(parent);
        frame();
        assertEquals(1, Probes.persistedBuilt);
        assertEquals(1, Probes.persistedRenders);
        final model:Model = parent;
        for (_ in 0...2) {
            app.notify(model.entityId);
            frame();
        }
        assertEquals(1, Probes.persistedBuilt, 'found again by its identity');
        assertEquals(1, Probes.persistedRenders, 'same props: not rendered again');
    }

    function testComponentKeepsTypeParameterConstraints() {
        // `component<T:Measurable>`: without the constraint the generated
        // `new ProbeHolder<T>(value)` would not compile
        final holder = ProbeHolder.component(new Measured(3));
        assertEquals(3, holder.size());
        final typed:ProbeHolder<Measured> = holder;
        assertEquals(3, typed.valueProp.measure());
    }

    function testHandWrittenComponentIsKept() {
        assertEquals('own', OwnFactory.component().originProp);
    }

    function testNoComponentForANonPublicConstructor() {
        assertEquals(-1, Type.getClassFields(Hidden).indexOf('component'));
        assertTrue(Type.getClassFields(Shown).indexOf('component') != -1);
        assertEquals('made', Hidden.make().nameProp);
    }

    function testParentElementComponentTakesItsChildrenThroughExtend() {
        final parent = view((_, _) -> div().child(Frame.component().child(div()).children([div(), null, div()])));
        openWindow(parent);
        frame();
        assertEquals(3, Probes.frameChildren);
    }

    function testInputGroupFindsAStatelessComponent() {
        final probe = Probe.component();
        final element:AnyElement = (probe : IntoElement);
        final found:Null<RenderOnce> = @:privateAccess InputGroupAddon.componentOf(element);
        assertTrue(found == probe);
    }

    static function pathString(ids:Array<ElementId>):String {
        return [for (id in ids) Std.string(id)].join('/');
    }

}

private class Probes {

    public static var paths:Array<Array<ElementId>> = [];

    public static var states:Array<Int> = [];

    public static var stateKeys:Array<String> = [];

    public static var nextState:Int = 0;

    public static var persistedBuilt:Int = 0;

    public static var persistedRenders:Int = 0;

    public static var frameChildren:Int = 0;

    public static function reset():Void {
        paths = [];
        states = [];
        stateKeys = [];
        nextState = 0;
        persistedBuilt = 0;
        persistedRenders = 0;
        frameChildren = 0;
    }

    public static function record(window:Window, cx:App):Void {
        final node = @:privateAccess window.elementIdNode;
        paths.push(node.ids());
        final state = window.useKeyedState('probe-state', cx, _ -> nextState++);
        states.push(state.read(cx).value);
        stateKeys.push(node.key);
    }

}

private interface Measurable {
    function measure():Int;
}

private class Measured implements Measurable {

    final value:Int;

    public function new(value:Int) {
        this.value = value;
    }

    public function measure():Int {
        return value;
    }

}

private interface ProbeItem extends RenderOnce {}

private class Probe extends Component {

    function render(window:Window, cx:App):IntoElement {
        Probes.record(window, cx);
        return div().w(px(10)).h(px(10));
    }

}

class PublicProbe extends Component {

    function render(window:Window, cx:App):IntoElement {
        Probes.record(window, cx);
        return div();
    }

}

class ProbeHolder<T:Measurable> extends Component {

    @prop public var value:T;

    public function new(value:T) {
        super();
        this.value = value;
    }

    public function size():Int {
        return value.measure();
    }

    function render(window:Window, cx:App):IntoElement {
        Probes.record(window, cx);
        return div().w(px(value.measure()));
    }

}

private class TaggedItem extends Component implements ProbeItem {

    @prop public var tag:String;

    public function new(tag:String) {
        super();
        this.tag = tag;
    }

    function render(window:Window, cx:App):IntoElement {
        return div().child(tag);
    }

}

@persist
private class Persisted extends Component {

    @prop var label:String = '';

    public function new() {
        super();
        Probes.persistedBuilt++;
    }

    function render(window:Window, cx:App):IntoElement {
        Probes.persistedRenders++;
        return div().child(label);
    }

}

private class OwnFactory extends Component {

    @prop public var origin:String = '';

    public function new() {
        super();
    }

    public static function component():OwnFactory {
        return new OwnFactory().origin('own');
    }

    function render(window:Window, cx:App):IntoElement {
        return div();
    }

}

@:keep
private class Hidden extends Component {

    @prop public var name:String = '';

    function new() {
        super();
    }

    public static function make():Hidden {
        return new Hidden().name('made');
    }

    function render(window:Window, cx:App):IntoElement {
        return div();
    }

}

@:keep
private class Shown extends Component {

    public function new() {
        super();
    }

    function render(window:Window, cx:App):IntoElement {
        return div();
    }

}

private class Frame extends Component implements ParentElement {

    final childElements:Array<AnyElement> = [];

    public function extend(elements:Array<AnyElement>):Void {
        for (element in elements) childElements.push(element);
    }

    function render(window:Window, cx:App):IntoElement {
        Probes.frameChildren = childElements.length;
        final root = div();
        for (child in childElements) root.child(child);
        return root;
    }

}
