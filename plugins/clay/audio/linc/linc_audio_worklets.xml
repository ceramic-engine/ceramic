<xml>

    <!-- audio_worklets: standalone audio worklet processing library.

         Compiles the plain C++ glue (lib/audio_worklets.cpp) and the
         reflaxe.CPP-transpiled worklet sources (through the unity file
         audio_worklets_all.cpp generated by the clay build tools) into
         the project, completely outside of the hxcpp runtime.

         AUDIO_WORKLETS_OUT is injected by the backend.AudioWorkletsLinc
         build macro, from the `audio_worklets_out` define set by the
         clay build tools. -->

    <files id="haxe">

        <!-- Only the C ABI header is exposed to the hxcpp side: the
             generated include dir must NOT be added here, as some of its
             headers (Std.h, ...) would clash with hxcpp's own headers. -->
        <compilerflag value="-I${LINC_AUDIO_WORKLETS_PATH}lib/"/>

    </files>

    <files id="audio_worklets">

        <compilerflag value="-I${LINC_AUDIO_WORKLETS_PATH}lib/"/>
        <compilerflag value="-I${AUDIO_WORKLETS_OUT}/include/"/>

        <!-- The unity file embeds a hash of every generated source, so
             depending on it is enough to rebuild the glue when the
             transpiled code (including its headers) changes -->
        <file name="${LINC_AUDIO_WORKLETS_PATH}lib/audio_worklets.cpp">
            <depend name="${LINC_AUDIO_WORKLETS_PATH}lib/audio_worklets.h"/>
            <depend name="${AUDIO_WORKLETS_OUT}/audio_worklets_all.cpp"/>
        </file>
        <file name="${AUDIO_WORKLETS_OUT}/audio_worklets_all.cpp">
            <depend name="${LINC_AUDIO_WORKLETS_PATH}lib/audio_worklets.h"/>
        </file>

    </files>

    <target id="haxe">
        <files id="audio_worklets"/>
    </target>

</xml>
