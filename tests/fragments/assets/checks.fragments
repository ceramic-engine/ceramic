{
  "menu": {
    "width": 320,
    "height": 240,
    "schema": {
      "ceramic.Quad": { "x": "Float", "y": "Float", "width": "Float", "height": "Float", "alpha": "Float" },
      "ceramic.Fragment": { "x": "Float", "y": "Float", "fragmentData": "ceramic.FragmentData" }
    },
    "items": [
      { "id": "panel", "entity": "ceramic.Quad", "props": { "x": 20, "y": 20, "width": 200, "height": 100 } },
      { "id": "button", "entity": "ceramic.Quad", "parent": "panel", "props": { "x": 10, "y": 10, "width": 80, "height": 30 } },
      { "id": "card", "entity": "ceramic.Fragment", "props": { "x": 100, "fragmentData": "card" } }
    ],
    "tracks": [
      {
        "entity": "button",
        "field": "alpha",
        "keyframes": [
          { "index": 0, "easing": "LINEAR", "value": 0 },
          { "index": 10, "easing": "BEZIER(0.25,0.1,0.25,1)", "value": 1 }
        ]
      }
    ],
    "labels": { "in": 0 },
    "editor": { "zoom": 2 }
  },
  "card": {
    "width": 60,
    "height": 80,
